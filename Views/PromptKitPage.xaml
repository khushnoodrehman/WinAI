<Page
    x:Class="WinAI.Views.PromptKitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppPageBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="54"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid Grid.Row="0"
              Background="{ThemeResource AppTopBarBackgroundBrush}"
              BorderBrush="{ThemeResource AppDividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="36"
                        Height="36"
                        Background="Transparent"
                        Click="BackButton_Click"
                        Margin="0,0,12,0"
                        ToolTipService.ToolTip="Back">
                    <TextBlock Text="&#xE72B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                </Button>
                <TextBlock Text="Prompt Kit"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" Padding="20,24">
            <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                <!-- Icon + Title Card -->
                <Border Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                        BorderThickness="1"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="&#xE7C3;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{ThemeResource AppAccentBrush}"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="Prompt Kit Library"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Curated system prompts, roleplay presets, coding templates, and quick commands tailored for mobile AI workflows. Coming soon in an upcoming WinAI update."
                                   FontSize="13.5"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="19"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
