<Page
    x:Class="WinAI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppPageBackgroundBrush}">

    <Grid>
        <!-- Overlay SplitView for Navigation Drawer -->
        <SplitView x:Name="NavDrawer"
                   DisplayMode="Overlay"
                   PanePlacement="Left"
                   OpenPaneLength="310"
                   LightDismissOverlayMode="On"
                   PaneBackground="{ThemeResource AppDrawerBackgroundBrush}"
                   IsPaneOpen="False">

            <!-- ==================== LEFT DRAWER PANE ==================== -->
            <SplitView.Pane>
                <Grid Background="{ThemeResource AppDrawerBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="0,32,0,32">
                            <!-- Drawer Header -->
                            <StackPanel Margin="24,0,16,28">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Win"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="AI"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppAccentBrush}" />
                                </StackPanel>
                                <TextBlock Text="Your AI. Your Keys. Your Device."
                                           FontSize="13"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Primary Menu Items -->
                            <!-- 1. Home -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerHome_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Home"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 2. New Chat -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerNewChat_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE15F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="New Chat"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 3. Conversations -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerConversations_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8FD;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Conversations"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 4. AI Providers -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerProviders_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80A;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="AI Providers"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 5. Key Vault -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerVault_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Key Vault"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 6. Prompt Kit -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerPromptKit_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7C3;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Prompt Kit"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Section Separator -->
                            <Border Height="1"
                                    Background="{ThemeResource AppDrawerDividerBrush}"
                                    Margin="24,14,24,14" />

                            <!-- Secondary Menu Items -->
                            <!-- 7. Settings (SELECTED in Settings view) -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerSettings_Click">
                                <Grid Background="{ThemeResource AppDrawerSelectedBrush}" Height="48">
                                    <Border Width="3.5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Background="{ThemeResource AppAccentBrush}" />

                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppAccentBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Settings"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 8. Privacy Center -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerPrivacy_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEA18;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Privacy Center"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 9. About -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerAbout_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE946;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="About"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>

            <!-- ==================== MAIN PAGE CONTENT ==================== -->
            <SplitView.Content>
                <Grid Background="{ThemeResource AppPageBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top App Bar (Height 50) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Main Scrollable Content Area -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ==================== TOP APP BAR ==================== -->
                    <Grid Grid.Row="0"
                          Height="50"
                          Background="{ThemeResource AppTopBarBackgroundBrush}"
                          Padding="16,0,16,0">
                        <Grid.ColumnDefinitions>
                            <!-- Column 0: Hamburger Menu -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Column 1: WinAI Logo -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Hamburger Menu Button -->
                        <Button Grid.Column="0"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                Padding="0"
                                Click="HamburgerButton_Click"
                                ToolTipService.ToolTip="Open Menu">
                            <TextBlock Text="&#xE700;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>

                        <!-- WinAI Brand Header -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Text="Win"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <TextBlock Text="AI"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{ThemeResource AppAccentBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- ==================== MAIN SCROLLABLE CONTENT ==================== -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="0,14,0,24">
                            <!-- Page Title & Subtitle -->
                            <StackPanel Margin="18,0,18,16">
                                <TextBlock Text="Settings"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Customize your experience."
                                           FontSize="13"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </StackPanel>

                            <!-- ==================== 1. APPEARANCE SECTION ==================== -->
                            <TextBlock Text="Appearance"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       Margin="18,10,18,8" />

                            <Border Margin="18,0,18,0"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <!-- Row 1: Theme -->
                                    <Grid Background="Transparent"
                                          Padding="16,13,16,13"
                                          Tapped="ThemeRow_Tapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Theme Icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE790;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- Titles -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                                            <TextBlock Text="Theme"
                                                       FontSize="15"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                            <TextBlock Text="Light or Dark"
                                                       FontSize="12"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <!-- Current Value & Chevron -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="ThemeValueText"
                                                       Text="Dark"
                                                       FontSize="13"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="54,0,0,0" />

                                    <!-- Row 2: Font Size -->
                                    <Grid Background="Transparent"
                                          Padding="16,13,16,13"
                                          Tapped="FontSizeRow_Tapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Font Size Icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="AA"
                                                   FontFamily="Segoe UI"
                                                   FontWeight="SemiBold"
                                                   FontSize="15"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- Titles -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                                            <TextBlock Text="Font Size"
                                                       FontSize="15"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                            <TextBlock Text="Small, Medium, Large"
                                                       FontSize="12"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <!-- Current Value & Chevron -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="FontSizeValueText"
                                                       Text="Medium"
                                                       FontSize="13"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="54,0,0,0" />

                                    <!-- Row 3: Language -->
                                    <Grid Background="Transparent"
                                          Padding="16,13,16,13"
                                          Tapped="LanguageRow_Tapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Globe Icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE774;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- Titles -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                                            <TextBlock Text="Language"
                                                       FontSize="15"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                            <TextBlock Text="App language"
                                                       FontSize="12"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <!-- Current Value & Chevron -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="LanguageValueText"
                                                       Text="English"
                                                       FontSize="13"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ==================== 2. AI & CHAT SECTION ==================== -->
                            <TextBlock Text="AI &amp; Chat"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       Margin="18,22,18,8" />

                            <Border Margin="18,0,18,0"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <!-- Row 1: Default Provider -->
                                    <Grid Background="Transparent"
                                          Padding="16,13,16,13"
                                          Tapped="DefaultProviderRow_Tapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Provider Icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE713;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- Titles -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                                            <TextBlock Text="Default Provider"
                                                       FontSize="15"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                            <TextBlock Text="Choose your preferred AI provider"
                                                       FontSize="12"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <!-- Current Value & Chevron -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="DefaultProviderValueText"
                                                       Text="OpenAI"
                                                       FontSize="13"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="54,0,0,0" />

                                    <!-- Row 2: Default Model -->
                                    <Grid Background="Transparent"
                                          Padding="16,13,16,13"
                                          Tapped="DefaultModelRow_Tapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Sliders Icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE9E9;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- Titles -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                                            <TextBlock Text="Default Model"
                                                       FontSize="15"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                            <TextBlock Text="Model to use for new chats"
                                                       FontSize="12"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <!-- Current Value & Chevron -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="DefaultModelValueText"
                                                       Text="GPT-4o"
                                                       FontSize="13"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="54,0,0,0" />

                                    <!-- Row 3: Chat History -->
                                    <Grid Background="Transparent"
                                          Padding="16,13,16,13"
                                          Tapped="ChatHistoryRow_Tapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Clock Icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE81C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- Titles -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                                            <TextBlock Text="Chat History"
                                                       FontSize="15"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                            <TextBlock Text="Manage your conversations"
                                                       FontSize="12"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <!-- Chevron -->
                                        <TextBlock Grid.Column="2"
                                                   Text="&#xE76C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="54,0,0,0" />

                                    <!-- Row 4: Clear All Conversations -->
                                    <Grid Background="Transparent"
                                          Padding="16,13,16,13"
                                          Tapped="ClearConversationsRow_Tapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Trash Icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE74D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- Titles -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                                            <TextBlock Text="Clear All Conversations"
                                                       FontSize="15"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                            <TextBlock Text="Delete all chat history"
                                                       FontSize="12"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <!-- Chevron -->
                                        <TextBlock Grid.Column="2"
                                                   Text="&#xE76C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ==================== 3. PRIVACY & SECURITY SECTION ==================== -->
                            <TextBlock Text="Privacy &amp; Security"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       Margin="18,22,18,8" />

                            <Border Margin="18,0,18,24"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <!-- Row 1: Key Vault -->
                                    <Grid Background="Transparent"
                                          Padding="16,13,16,13"
                                          Tapped="KeyVaultRow_Tapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Lock Icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE72E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- Titles -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                                            <TextBlock Text="Key Vault"
                                                       FontSize="15"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                            <TextBlock Text="Manage your API keys"
                                                       FontSize="12"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <!-- Chevron -->
                                        <TextBlock Grid.Column="2"
                                                   Text="&#xE76C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="54,0,0,0" />

                                    <!-- Row 2: Privacy Center -->
                                    <Grid Background="Transparent"
                                          Padding="16,13,16,13"
                                          Tapped="PrivacyCenterRow_Tapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Shield Icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xEA18;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- Titles -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                                            <TextBlock Text="Privacy Center"
                                                       FontSize="15"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                            <TextBlock Text="Data and privacy settings"
                                                       FontSize="12"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <!-- Chevron -->
                                        <TextBlock Grid.Column="2"
                                                   Text="&#xE76C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Notification / Status Banner (subtle popup) -->
                            <Border x:Name="NotificationBanner"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,10"
                                    Margin="18,0,18,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{ThemeResource AppAccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <TextBlock x:Name="NotificationText"
                                               Text="Operation completed."
                                               FontSize="13"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>
