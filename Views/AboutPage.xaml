<Page
    x:Class="WinAI.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppPageBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="54"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid Grid.Row="0"
              Background="{ThemeResource AppTopBarBackgroundBrush}"
              BorderBrush="{ThemeResource AppDividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="36"
                        Height="36"
                        Background="Transparent"
                        Click="BackButton_Click"
                        Margin="0,0,12,0"
                        ToolTipService.ToolTip="Back">
                    <TextBlock Text="&#xE72B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                </Button>
                <TextBlock Text="About WinAI"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" Padding="20,24">
            <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                <!-- App Info Card -->
                <Border Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                        BorderThickness="1"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- App Title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Win"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                            <TextBlock Text="AI"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource AppAccentBrush}"/>
                        </StackPanel>

                        <TextBlock Text="Version 1.0 (Fall Creators Update)"
                                   FontSize="13"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Your AI. Your Keys. Your Device."
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppAccentBrush}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="A native, fast, and authentic Windows 10 Mobile application bringing modern AI providers to Windows Phone hardware with privacy, offline key storage, and Fluent-Metro design."
                                   FontSize="13.5"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="19"/>
                    </StackPanel>
                </Border>

                <!-- Local Database Diagnostics -->
                <Border Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                        BorderThickness="1"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Local Storage &amp; Database Diagnostics"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Run automated unit &amp; integration tests on the local SQLite conversation engine to verify persistence, transactions, and context building."
                                   FontSize="13"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>

                        <Button x:Name="RunTestsButton"
                                Content="Run Database Verification Tests"
                                Background="{ThemeResource AppButtonBackgroundBrush}"
                                Foreground="{ThemeResource AppButtonForegroundBrush}"
                                HorizontalAlignment="Stretch"
                                Click="RunTestsButton_Click"/>

                        <TextBlock x:Name="TestResultsText"
                                   FontSize="12"
                                   Foreground="{ThemeResource AppAccentBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
