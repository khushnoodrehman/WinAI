<Page
    x:Class="WinAI.Views.ImagesGalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:WinAI.Controls"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppPageBackgroundBrush}">
        <!-- Notification Banner at root level -->
        <Border x:Name="NotificationBanner"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource AppAccentBrush}"
                Padding="16,10"
                Canvas.ZIndex="1000"
                Visibility="Collapsed">
            <TextBlock x:Name="NotificationText"
                       Text="Notification"
                       Foreground="White"
                       FontSize="13"
                       FontFamily="Segoe UI"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- ==================== SPLITVIEW NAVIGATION DRAWER ==================== -->
        <SplitView x:Name="NavDrawer"
                    DisplayMode="Overlay"
                    IsPaneOpen="False"
                    OpenPaneLength="280"
                    PanePlacement="Left">
            <SplitView.Pane>
                <Grid Background="{ThemeResource AppDrawerBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <Border Grid.Row="0"
                            Padding="24,20,24,16"
                            BorderBrush="{ThemeResource AppDrawerDividerBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="ms-appx:///Assets/AppLogo.png"
                                       Width="26"
                                       Height="26"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="Win"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock Text="AI"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppAccentBrush}" />
                            </StackPanel>
                            <TextBlock Text="Local Media &amp; Images"
                                       FontSize="12"
                                       FontFamily="Segoe UI"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Drawer Menu Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="0,8,0,16">
                            <!-- 1. Home -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}" Click="DrawerHome_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" Foreground="{ThemeResource AppDrawerIconBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Home" FontSize="15" FontFamily="Segoe UI" Foreground="{ThemeResource AppTextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 2. New Chat -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}" Click="DrawerNewChat_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE15F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" Foreground="{ThemeResource AppDrawerIconBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="New Chat" FontSize="15" FontFamily="Segoe UI" Foreground="{ThemeResource AppTextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 3. Conversations -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}" Click="DrawerConversations_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" Foreground="{ThemeResource AppDrawerIconBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Conversations" FontSize="15" FontFamily="Segoe UI" Foreground="{ThemeResource AppTextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 4. Your Images (Current Page) -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}" Background="{ThemeResource AppDrawerSelectedBrush}" Click="DrawerImages_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Your Images" FontSize="15" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 5. AI Providers -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}" Click="DrawerProviders_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" Foreground="{ThemeResource AppDrawerIconBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="AI Providers" FontSize="15" FontFamily="Segoe UI" Foreground="{ThemeResource AppTextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 6. Key Vault -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}" Click="DrawerVault_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" Foreground="{ThemeResource AppDrawerIconBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Key Vault" FontSize="15" FontFamily="Segoe UI" Foreground="{ThemeResource AppTextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 7. Prompt Kit -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}" Click="DrawerPromptKit_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" Foreground="{ThemeResource AppDrawerIconBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Prompt Kit" FontSize="15" FontFamily="Segoe UI" Foreground="{ThemeResource AppTextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Section Separator -->
                            <Border Height="1" Background="{ThemeResource AppDrawerDividerBrush}" Margin="24,14,24,14" />

                            <!-- 8. Settings -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}" Click="DrawerSettings_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" Foreground="{ThemeResource AppDrawerIconBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Settings" FontSize="15" FontFamily="Segoe UI" Foreground="{ThemeResource AppTextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 9. Privacy Center -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}" Click="DrawerPrivacy_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" Foreground="{ThemeResource AppDrawerIconBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Privacy Center" FontSize="15" FontFamily="Segoe UI" Foreground="{ThemeResource AppTextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 10. About WinAI -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}" Click="DrawerAbout_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" Foreground="{ThemeResource AppDrawerIconBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="About WinAI" FontSize="15" FontFamily="Segoe UI" Foreground="{ThemeResource AppTextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>

            <!-- ==================== MAIN CONTENT ==================== -->
            <SplitView.Content>
                <Grid Background="{ThemeResource AppPageBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <!-- Top Header Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Content Area -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource AppTopBarBackgroundBrush}"
                            BorderBrush="{ThemeResource AppDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10,14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Hamburger Menu Button -->
                            <Button Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    Background="Transparent"
                                    Padding="0"
                                    Click="HamburgerButton_Click">
                                <TextBlock Text="&#xE700;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </Button>

                            <!-- Title & Subtitle -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Your Images"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="ImageCountText"
                                           Text="Loading media..."
                                           FontSize="11.5"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Refresh & Cleanup Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Width="38"
                                        Height="38"
                                        Background="Transparent"
                                        Padding="0"
                                        Click="RefreshButton_Click"
                                        ToolTipService.ToolTip="Refresh Gallery">
                                    <TextBlock Text="&#xE72C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Gallery Grid & Empty State -->
                    <Grid Grid.Row="1">
                        <!-- Loading Ring -->
                        <ProgressRing x:Name="LoadingRing"
                                      IsActive="True"
                                      Width="40"
                                      Height="40"
                                      Foreground="{ThemeResource AppAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />

                        <!-- Empty State View -->
                        <StackPanel x:Name="EmptyStatePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    MaxWidth="320"
                                    Padding="24">
                            <Border Width="64"
                                    Height="64"
                                    CornerRadius="32"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,16">
                                <TextBlock Text="&#xEB9F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="26"
                                           Foreground="{ThemeResource AppAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="No Images Found"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       TextAlignment="Center"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="Images attached to your chats or captured via camera will be safely stored here in your local offline gallery."
                                       FontSize="13"
                                       FontFamily="Segoe UI"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,0,0,20" />

                            <Button Content="Start New Chat"
                                    Background="{ThemeResource AppAccentBrush}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="24,10"
                                    HorizontalAlignment="Center"
                                    Click="StartNewChatButton_Click" />
                        </StackPanel>

                        <!-- Images GridView -->
                        <GridView x:Name="ImagesGridView"
                                  Padding="12,12,12,24"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="ImagesGridView_ItemClick">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="6" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="160"
                                            Height="160"
                                            CornerRadius="10"
                                            Background="{ThemeResource AppSurfaceBrush}"
                                            BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <!-- Thumbnail Image -->
                                            <Image Source="{Binding ThumbnailSource}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                            <!-- Bottom Info Gradient Overlay -->
                                            <Border VerticalAlignment="Bottom"
                                                    CornerRadius="0,0,9,9"
                                                    Padding="8,16,8,6">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <GradientStop Color="#00000000" Offset="0.0" />
                                                        <GradientStop Color="#CC000000" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding FormattedDate}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding FormattedSize}"
                                                               FontSize="9.5"
                                                               Foreground="#DDD"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </Grid>
            </SplitView.Content>
        </SplitView>

        <!-- ==================== FULL-SIZE IMAGE PREVIEW LIGHTBOX ==================== -->
        <Grid x:Name="LightboxOverlay"
              Canvas.ZIndex="2000"
              Visibility="Collapsed"
              Background="#EE000000">
            <Grid.RowDefinitions>
                <!-- Top Action Header -->
                <RowDefinition Height="Auto" />
                <!-- Center Zoomable Image Viewport -->
                <RowDefinition Height="*" />
                <!-- Bottom Action Controls -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Padding="16,14,16,10"
                    Background="#55000000">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Close Button -->
                    <Button Grid.Column="0"
                            Width="38"
                            Height="38"
                            Background="Transparent"
                            Padding="0"
                            Click="CloseLightbox_Click">
                        <TextBlock Text="&#xE106;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="White" />
                    </Button>

                    <!-- Title & Dimensions -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                        <TextBlock x:Name="LightboxTitleText"
                                   Text="Image Details"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LightboxSubtitleText"
                                   Text="Dimensions &amp; Size"
                                   FontSize="11"
                                   Foreground="#AAA" />
                    </StackPanel>

                    <!-- Delete Button -->
                    <Button Grid.Column="2"
                            Width="38"
                            Height="38"
                            Background="Transparent"
                            Padding="0"
                            Click="DeleteCurrentImage_Click"
                            ToolTipService.ToolTip="Delete Image">
                        <TextBlock Text="&#xE74D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="#EF4444" />
                    </Button>
                </Grid>
            </Border>

            <!-- Zoomable Image Viewport Container -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="LightboxScrollViewer"
                              ZoomMode="Enabled"
                              MinZoomFactor="1.0"
                              MaxZoomFactor="4.0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalSnapPointsType="None"
                              VerticalSnapPointsType="None"
                              SizeChanged="LightboxScrollViewer_SizeChanged"
                              ViewChanged="LightboxScrollViewer_ViewChanged">
                    <Grid x:Name="LightboxImageContainer"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          DoubleTapped="LightboxImageContainer_DoubleTapped">
                        <ProgressRing x:Name="LightboxLoadingRing"
                                      IsActive="True"
                                      Width="45"
                                      Height="45"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />

                        <Image x:Name="LightboxImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               ImageOpened="LightboxImage_ImageOpened"
                               ImageFailed="LightboxImage_ImageFailed" />
                    </Grid>
                </ScrollViewer>

                <!-- Floating Zoom Toolbar -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,16"
                        CornerRadius="20"
                        Background="#D016181C"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Zoom Out -->
                        <Button Width="36" Height="36"
                                Background="Transparent"
                                Padding="0"
                                Click="ZoomOut_Click"
                                ToolTipService.ToolTip="Zoom Out">
                            <TextBlock Text="&#xE71F;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>

                        <!-- Zoom Level Percentage -->
                        <TextBlock x:Name="ZoomLevelText"
                                   Text="100%"
                                   Width="48"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center" />

                        <!-- Zoom In -->
                        <Button Width="36" Height="36"
                                Background="Transparent"
                                Padding="0"
                                Click="ZoomIn_Click"
                                ToolTipService.ToolTip="Zoom In">
                            <TextBlock Text="&#xE71E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>

                        <Border Width="1" Height="18" Background="#44FFFFFF" Margin="4,0,4,0" />

                        <!-- Fit to Screen / Reset -->
                        <Button Width="36" Height="36"
                                Background="Transparent"
                                Padding="0"
                                Click="ZoomReset_Click"
                                ToolTipService.ToolTip="Fit to Screen">
                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Navigation & Action Bar -->
            <Border Grid.Row="2"
                    Padding="16,10,16,14"
                    Background="#66000000">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- "Go to Conversation" Button -->
                    <Button Grid.Column="0"
                            x:Name="GoToChatButton"
                            Height="40"
                            Background="{ThemeResource AppAccentBrush}"
                            Foreground="White"
                            HorizontalAlignment="Left"
                            Padding="16,4"
                            Click="GoToChatButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8FD;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Open in Chat"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Save to Pictures Library Button -->
                    <Button Grid.Column="1"
                            Height="40"
                            Background="#33FFFFFF"
                            Foreground="White"
                            Padding="14,4"
                            Click="SaveToPictures_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE74E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Save to Pictures"
                                       FontSize="12.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
