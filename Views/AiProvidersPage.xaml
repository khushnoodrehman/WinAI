<Page
    x:Class="WinAI.Views.AiProvidersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:WinAI.Controls"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppPageBackgroundBrush}">
        <!-- Notification Banner at root level -->
        <Border x:Name="NotificationBanner"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource AppAccentBrush}"
                Padding="16,10"
                Canvas.ZIndex="100"
                Visibility="Collapsed">
            <TextBlock x:Name="NotificationText"
                       Text="Notification"
                       Foreground="White"
                       FontSize="13"
                       FontFamily="Segoe UI"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- ==================== SPLITVIEW NAVIGATION DRAWER ==================== -->
        <SplitView x:Name="NavDrawer"
                   DisplayMode="Overlay"
                   IsPaneOpen="False"
                   OpenPaneLength="280"
                   PanePlacement="Left">
            <SplitView.Pane>
                <Grid Background="{ThemeResource AppDrawerBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <Border Grid.Row="0"
                            Padding="24,20,24,16"
                            BorderBrush="{ThemeResource AppDrawerDividerBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="ms-appx:///Assets/AppLogo.png"
                                       Width="26"
                                       Height="26"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="Win"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock Text="AI"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppAccentBrush}" />
                            </StackPanel>
                            <TextBlock Text="AI Providers &amp; Discovery"
                                       FontSize="12"
                                       FontFamily="Segoe UI"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Drawer Menu Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="0,8,0,16">
                            <!-- 1. Home -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerHome_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Home"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 2. New Chat -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerNewChat_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE15F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="New Chat"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 3. Conversations -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerConversations_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8FD;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Conversations"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 4. AI Providers (Current Page) -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Background="{ThemeResource AppDrawerSelectedBrush}"
                                    Click="DrawerProviders_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80A;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppAccentBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="AI Providers"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppAccentBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 5. Key Vault -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerVault_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Key Vault"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 6. Prompt Kit -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerPromptKit_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE70F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Prompt Kit"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Divider -->
                            <Border Height="1"
                                    Background="{ThemeResource AppDrawerDividerBrush}"
                                    Margin="24,14,24,14" />

                            <!-- 7. Settings -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerSettings_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Settings"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 8. Privacy Center -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerPrivacy_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEA18;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Privacy Center"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 9. About WinAI -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerAbout_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE946;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="About WinAI"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>

            <!-- ==================== MAIN PAGE CONTENT ==================== -->
            <SplitView.Content>
                <Grid Background="{ThemeResource AppPageBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top App Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Main Scrollable Content Area -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ==================== TOP APP BAR ==================== -->
                    <Grid Grid.Row="0"
                          Height="50"
                          Background="{ThemeResource AppTopBarBackgroundBrush}"
                          Padding="16,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Hamburger Button -->
                        <Button Grid.Column="0"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                Padding="0"
                                Click="HamburgerButton_Click"
                                ToolTipService.ToolTip="Open Menu">
                            <TextBlock Text="&#xE700;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>

                        <!-- WinAI Logo -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <Image Source="ms-appx:///Assets/AppLogo.png"
                                   Width="22"
                                   Height="22"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Win"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <TextBlock Text="AI"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{ThemeResource AppAccentBrush}" />
                        </StackPanel>

                        <!-- Key Vault Shortcut Button -->
                        <Button Grid.Column="2"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                Padding="0"
                                Click="KeyVaultShortcut_Click"
                                ToolTipService.ToolTip="Key Vault">
                            <TextBlock Text="&#xE72E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- ==================== MAIN SCROLLABLE CONTENT ==================== -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="0,14,0,24">
                            <!-- Page Title & Subtitle -->
                            <StackPanel Margin="18,0,18,16">
                                <TextBlock Text="AI Providers"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Manage registered AI providers, view cached models, and test connections."
                                           FontSize="13"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Quick Action Bar -->
                            <Grid Margin="18,0,18,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="REGISTERED PROVIDERS"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        x:Name="RefreshAllButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="8,4"
                                        Click="RefreshAllButton_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AppAccentBrush}"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Refresh"
                                                   FontSize="12"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppAccentBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Flat Providers ListView -->
                            <ListView x:Name="ProvidersListView"
                                      ItemContainerStyle="{StaticResource WinAIListViewItemStyle}"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="ProvidersListView_ItemClick"
                                      Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="66"
                                              Background="Transparent"
                                              BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                              BorderThickness="0,0,0,1"
                                              Padding="18,0,18,0">
                                            <Grid.ColumnDefinitions>
                                                <!-- Col 0: Icon Badge -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Col 1: Provider Info -->
                                                <ColumnDefinition Width="*" />
                                                <!-- Col 2: Chevron -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Provider Icon Badge -->
                                            <controls:WinAIProviderIcon Grid.Column="0"
                                                                        ProviderId="{Binding Id}"
                                                                        IconSize="38"
                                                                        BadgeCornerRadius="8"
                                                                        Margin="0,0,14,0"
                                                                        VerticalAlignment="Center" />

                                            <!-- Provider Details -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="15.5"
                                                           FontWeight="SemiBold"
                                                           FontFamily="Segoe UI"
                                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,3,0,0"
                                                            VerticalAlignment="Center">
                                                    <!-- Configured Status Dot & Text -->
                                                    <TextBlock Text="{Binding StatusDot}"
                                                               FontSize="10"
                                                               Foreground="{Binding StatusBrush}"
                                                               Margin="0,0,4,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="12.5"
                                                               FontFamily="Segoe UI"
                                                               Foreground="{Binding StatusBrush}"
                                                               VerticalAlignment="Center" />

                                                    <!-- Separator -->
                                                    <TextBlock Text=" • "
                                                               FontSize="12"
                                                               Foreground="{ThemeResource AppTextMutedBrush}"
                                                               VerticalAlignment="Center" />

                                                    <!-- Model Count -->
                                                    <TextBlock Text="{Binding ModelCountText}"
                                                               FontSize="12.5"
                                                               FontFamily="Segoe UI"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Chevron Arrow -->
                                            <TextBlock Grid.Column="2"
                                                       Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource AppTextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Bottom Help Note -->
                            <Border Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="18,20,18,0"
                                    Padding="14,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#xE946;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="{ThemeResource AppAccentBrush}"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Provider Discovery &amp; Diagnostics"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Tap any provider above to discover supported models, perform diagnostic connection tests, or view availability status. Models discovered from active APIs are cached locally on this phone."
                                               FontSize="12"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>
