<Page
    x:Class="WinAI.Views.KeyVaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinAI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppPageBackgroundBrush}">

    <Grid>
        <!-- Overlay SplitView for Navigation Drawer -->
        <SplitView x:Name="NavDrawer"
                   DisplayMode="Overlay"
                   PanePlacement="Left"
                   OpenPaneLength="310"
                   LightDismissOverlayMode="On"
                   PaneBackground="{ThemeResource AppDrawerBackgroundBrush}"
                   IsPaneOpen="False">

            <!-- ==================== LEFT DRAWER PANE ==================== -->
            <SplitView.Pane>
                <Grid Background="{ThemeResource AppDrawerBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="0,32,0,32">
                            <!-- Drawer Header -->
                            <StackPanel Margin="24,0,16,28">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Win"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="AI"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppAccentBrush}" />
                                </StackPanel>
                                <TextBlock Text="Your AI. Your Keys. Your Device."
                                           FontSize="13"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Primary Menu Items -->
                            <!-- 1. Home -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerHome_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Home"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 2. New Chat -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerNewChat_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE15F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="New Chat"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 3. Conversations -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerConversations_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8FD;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Conversations"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 4. AI Providers -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerProviders_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80A;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="AI Providers"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 5. Key Vault (SELECTED in Key Vault view) -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerVault_Click">
                                <Grid Background="{ThemeResource AppDrawerSelectedBrush}" Height="48">
                                    <Border Width="3.5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Background="{ThemeResource AppAccentBrush}" />

                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppAccentBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Key Vault"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 6. Prompt Kit -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerPromptKit_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7C3;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Prompt Kit"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Section Separator -->
                            <Border Height="1"
                                    Background="{ThemeResource AppDrawerDividerBrush}"
                                    Margin="24,14,24,14" />

                            <!-- Secondary Menu Items -->
                            <!-- 7. Settings -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerSettings_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Settings"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 8. Privacy Center -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerPrivacy_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEA18;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Privacy Center"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 9. About -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="DrawerAbout_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE946;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="About"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>

            <!-- ==================== MAIN PAGE CONTENT ==================== -->
            <SplitView.Content>
                <Grid Background="{ThemeResource AppPageBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top App Bar (Height 50) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Main Scrollable Content Area -->
                        <RowDefinition Height="*" />
                        <!-- Row 2: Fixed Bottom Navigation Bar (Height 54) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ==================== TOP APP BAR ==================== -->
                    <Grid Grid.Row="0"
                          Height="50"
                          Background="{ThemeResource AppTopBarBackgroundBrush}"
                          Padding="16,0,16,0">
                        <Grid.ColumnDefinitions>
                            <!-- Column 0: Hamburger Menu -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Column 1: WinAI Logo -->
                            <ColumnDefinition Width="*" />
                            <!-- Column 2: Plus (+) Action -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Hamburger Menu Button -->
                        <Button Grid.Column="0"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                Padding="0"
                                Click="HamburgerButton_Click"
                                ToolTipService.ToolTip="Open Menu">
                            <TextBlock Text="&#xE700;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>

                        <!-- WinAI Brand Header -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Text="Win"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <TextBlock Text="AI"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{ThemeResource AppAccentBrush}" />
                        </StackPanel>

                        <!-- Plus (+) Button -> Add API Key -->
                        <Button Grid.Column="2"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                Padding="0"
                                Click="AddKeyButton_Click"
                                ToolTipService.ToolTip="Add API Key">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- ==================== MAIN SCROLLABLE CONTENT ==================== -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="0,14,0,24">
                            <!-- Page Title & Subtitle -->
                            <StackPanel Margin="18,0,18,16">
                                <TextBlock Text="Key Vault"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="Your API keys are stored securely on your device.&#x0a;Never uploaded."
                                           FontSize="13"
                                           LineHeight="18"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- "Local Only" Information Card -->
                            <Border Margin="18,0,18,18"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Blue Solid Lock Icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="&#xE72E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="28"
                                               Foreground="{ThemeResource AppAccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0" />

                                    <!-- Texts -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Local Only"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="100% on your device"
                                                   FontSize="12.5"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Saved API Keys Section Header -->
                            <Grid Margin="18,0,18,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Saved API Keys"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        x:Name="ManageButton"
                                        Background="Transparent"
                                        Padding="4,2"
                                        Click="ManageButton_Click"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Manage &gt;"
                                               FontSize="13"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppAccentBrush}" />
                                </Button>
                            </Grid>

                            <!-- Provider List: OpenAI, Gemini, Claude, Perplexity, DeepSeek, xAI -->
                            <StackPanel x:Name="ProvidersContainer">
                                <controls:VaultProviderItem x:Name="OpenAiItem"
                                                            ProviderId="openai"
                                                            ProviderName="OpenAI" />

                                <controls:VaultProviderItem x:Name="GeminiItem"
                                                            ProviderId="gemini"
                                                            ProviderName="Gemini" />

                                <controls:VaultProviderItem x:Name="ClaudeItem"
                                                            ProviderId="claude"
                                                            ProviderName="Claude" />

                                <controls:VaultProviderItem x:Name="PerplexityItem"
                                                            ProviderId="perplexity"
                                                            ProviderName="Perplexity" />

                                <controls:VaultProviderItem x:Name="DeepSeekItem"
                                                            ProviderId="deepseek"
                                                            ProviderName="DeepSeek" />

                                <controls:VaultProviderItem x:Name="XAiItem"
                                                            ProviderId="xai"
                                                            ProviderName="xAI" />
                            </StackPanel>

                            <!-- + Add API Key Button -->
                            <Border Height="44"
                                    Margin="18,16,18,16"
                                    Background="{ThemeResource AppAccentBrush}"
                                    CornerRadius="8">
                                <Button x:Name="AddKeyActionButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        Foreground="White"
                                        Click="AddKeyButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE710;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="Add API Key"
                                                   FontSize="14.5"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Border>

                            <!-- Lock Vault Card -->
                            <Border x:Name="LockVaultCardBorder"
                                    Margin="18,0,18,20"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12"
                                    Tapped="LockVaultCard_Tapped">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Blue Lock Icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="&#xE72E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="18"
                                               Foreground="{ThemeResource AppAccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0" />

                                    <!-- Texts -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Lock Vault"
                                                   FontSize="14.5"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                        <TextBlock x:Name="LockVaultSubtitle"
                                                   Text="Set a PIN to protect your keys"
                                                   FontSize="12"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Chevron Right -->
                                    <TextBlock Grid.Column="2"
                                               Text="&#xE76C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Notification / Status Banner (subtle popup) -->
                            <Border x:Name="NotificationBanner"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,10"
                                    Margin="18,0,18,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{ThemeResource AppAccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <TextBlock x:Name="NotificationText"
                                               Text="Operation completed."
                                               FontSize="13"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== BOTTOM NAVIGATION (Vault Selected) ==================== -->
                    <Border Grid.Row="2"
                            Height="54"
                            Background="{ThemeResource AppBottomNavBackgroundBrush}"
                            BorderBrush="{ThemeResource AppBottomNavBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tab 1: Home -->
                            <Button Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Padding="0"
                                    Click="BottomHome_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE80F;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Home"
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,4" />
                                </StackPanel>
                            </Button>

                            <!-- Tab 2: Chats -->
                            <Button Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Padding="0"
                                    Click="BottomChats_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8BD;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Chats"
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,4" />
                                </StackPanel>
                            </Button>

                            <!-- Tab 3: Vault (SELECTED ACTIVE) -->
                            <Button Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Padding="0"
                                    Click="BottomVault_Click">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="{ThemeResource AppAccentBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Vault"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppAccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,4" />
                                    </StackPanel>
                                    <!-- Blue bottom selection indicator bar -->
                                    <Border Height="2.5"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Center"
                                            Width="38"
                                            Background="{ThemeResource AppAccentBrush}" />
                                </Grid>
                            </Button>

                            <!-- Tab 4: More -->
                            <Button Grid.Column="3"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Padding="0"
                                    Click="BottomMore_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE700;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="More"
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,4" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>
