<Page
    x:Class="WinAI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinAI.Views"
    xmlns:controls="using:WinAI.Controls"
    xmlns:models="using:WinAI.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppPageBackgroundBrush}">

    <Grid>
        <!-- Overlay SplitView for Hamburger Navigation Drawer -->
        <SplitView x:Name="NavDrawer"
                   DisplayMode="Overlay"
                   PanePlacement="Left"
                   OpenPaneLength="310"
                   LightDismissOverlayMode="On"
                   PaneBackground="{ThemeResource AppDrawerBackgroundBrush}"
                   IsPaneOpen="False">

            <!-- ==================== LEFT DRAWER PANE ==================== -->
            <SplitView.Pane>
                <Grid Background="{ThemeResource AppDrawerBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="0,32,0,32">
                            <!-- Drawer Header -->
                            <StackPanel Margin="24,0,16,28">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                    <Image Source="ms-appx:///Assets/AppLogo.png"
                                           Width="28"
                                           Height="28"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                                    <TextBlock Text="Win"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="AI"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppAccentBrush}" />
                                </StackPanel>
                                <TextBlock Text="Your AI. Your Keys. Your Device."
                                           FontSize="13"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Primary Menu Items -->
                            <!-- 1. Home (Selected) -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="HomeItem_Click">
                                <Grid Background="{ThemeResource AppDrawerSelectedBrush}" Height="48">
                                    <!-- Blue vertical indicator on the far left -->
                                    <Border Width="3.5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Background="{ThemeResource AppAccentBrush}" />

                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppAccentBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Home"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 2. New Chat -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="NewChatItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE15F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="New Chat"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 3. Conversations -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="ConversationsItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8FD;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Conversations"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 4. AI Providers -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="AiProvidersItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80A;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="AI Providers"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 5. Key Vault -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="KeyVaultItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Key Vault"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 6. Prompt Kit -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="PromptKitItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7C3;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Prompt Kit"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Section Separator -->
                            <Border Height="1"
                                    Background="{ThemeResource AppDrawerDividerBrush}"
                                    Margin="24,14,24,14" />

                            <!-- Secondary Menu Items -->
                            <!-- 7. Settings -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="SettingsItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Settings"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 8. Privacy Center -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="PrivacyCenterItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEA18;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Privacy Center"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 9. About WinAI -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="AboutWinAiItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE946;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="About WinAI"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>

            <!-- ==================== MAIN PAGE VIEW ==================== -->
            <SplitView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top App Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Scrollable Page Content -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ==================== ROW 0: TOP APP BAR ==================== -->
                    <Grid Grid.Row="0"
                          Height="52"
                          Background="{ThemeResource AppTopBarBackgroundBrush}"
                          Padding="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Hamburger Menu Icon -->
                        <Button Grid.Column="0"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                Click="Hamburger_Click"
                                ToolTipService.ToolTip="Menu">
                            <TextBlock Text="&#xE700;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </Button>

                        <!-- Center/Left: "WinAI" Title -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <Image Source="ms-appx:///Assets/AppLogo.png"
                                   Width="22"
                                   Height="22"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Win"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <TextBlock Text="AI"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource AppAccentBrush}" />
                        </StackPanel>

                        <!-- Right: Settings Gear Icon -->
                        <Button Grid.Column="2"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                Click="Settings_Click"
                                ToolTipService.ToolTip="Settings">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- ==================== ROW 1: SCROLLABLE CONTENT ==================== -->
                    <ScrollViewer Grid.Row="1"
                                  Padding="20,0,20,24"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Greeting & AI Launcher Hero Section -->
                            <StackPanel Margin="0,20,0,16">
                                <TextBlock x:Name="GreetingTitleText"
                                           Text="Good morning."
                                           FontSize="18"
                                           FontWeight="Normal"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                <TextBlock Text="What's on your mind?"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Home Attachment Preview Bar -->
                            <Border x:Name="HomeAttachmentPreviewBar"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,6"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="HomeAttachmentThumbnailImage"
                                           Grid.Column="0"
                                           Width="40"
                                           Height="40"
                                           Stretch="UniformToFill"
                                           Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="HomeAttachmentFileNameText"
                                                   Text="Image Attached"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Ready for Vision Analysis"
                                                   FontSize="10.5"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Width="30"
                                            Height="30"
                                            Background="Transparent"
                                            Click="HomeRemoveAttachment_Click">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Modern Translucent Launcher Composer Bar matching Screenshot 2 & 3 -->
                            <Border Background="{ThemeResource AppTranslucentBarBrush}"
                                    BorderBrush="{ThemeResource AppTranslucentBarBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="24"
                                    MinHeight="46"
                                    Padding="6,2,6,2"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <!-- State 1: Normal Input Bar (Screenshot 2) -->
                                    <Grid x:Name="HomeNormalInputGrid" Visibility="Visible">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: + Attachment Button -->
                                        <Button x:Name="HomeAttachButton"
                                                Grid.Column="0"
                                                Style="{StaticResource WinAIIconButtonStyle}"
                                                Width="38"
                                                Height="38"
                                                VerticalAlignment="Center"
                                                Click="HomeAttachButton_Click"
                                                ToolTipService.ToolTip="Add attachment">
                                            <TextBlock Text="&#xE710;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="19"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Center: Input Box (Transparent, never white on focus) -->
                                        <TextBox x:Name="HomePromptTextBox"
                                                 Grid.Column="1"
                                                 Style="{StaticResource WinAITransparentTextBoxStyle}"
                                                 PlaceholderText="Type a message"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="36"
                                                 MaxHeight="96"
                                                 InputScope="Chat"
                                                 FontSize="15"
                                                 Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="4,0,4,0"
                                                 KeyDown="HomePromptTextBox_KeyDown"
                                                 TextChanged="HomePromptTextBox_TextChanged"/>

                                        <!-- Right 1: Voice Microphone Button (Matches Windows Phone theme) -->
                                        <Button x:Name="HomeVoiceRecordButton"
                                                Grid.Column="2"
                                                Style="{StaticResource WinAIIconButtonStyle}"
                                                Width="38"
                                                Height="38"
                                                VerticalAlignment="Center"
                                                Click="HomeVoiceRecordButton_Click"
                                                ToolTipService.ToolTip="Voice message">
                                            <TextBlock Text="&#xE720;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="19"
                                                       Foreground="{ThemeResource AppAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Right 2: Send Button (Matches Windows Phone theme) -->
                                        <Button x:Name="HomeSendButton"
                                                Grid.Column="3"
                                                Style="{StaticResource WinAIIconButtonStyle}"
                                                Width="38"
                                                Height="38"
                                                VerticalAlignment="Center"
                                                Click="HomeSendButton_Click"
                                                ToolTipService.ToolTip="Send prompt">
                                            <TextBlock Text="&#xE724;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       Foreground="{ThemeResource AppAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>

                                    <!-- State 2: Active Voice Recording Bar (Native Windows Phone Listening UI) -->
                                    <Grid x:Name="HomeVoiceRecordingGrid" Visibility="Collapsed" MinHeight="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Column 0: Animated Microphone Indicator -->
                                        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="6,0,8,0" Width="28" Height="28">
                                            <Ellipse x:Name="HomeVoicePulseDot"
                                                     Width="28" Height="28"
                                                     Fill="{ThemeResource AppVoiceRecordActiveBrush}"
                                                     Opacity="0.25"/>
                                            <TextBlock x:Name="HomeVoiceMicIcon"
                                                       Text="&#xE720;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       Foreground="{ThemeResource AppVoiceRecordActiveBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Column 1: Status & Live Transcription -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,2,6,2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Top line: Status, Timer, and subtle waveform bars -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="HomeVoiceRecordingStatusText"
                                                           Text="Listening..."
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AppVoiceRecordActiveBrush}"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock x:Name="HomeVoiceRecordingTimerText"
                                                           Text="0:00"
                                                           FontSize="13"
                                                           FontFamily="Segoe UI"
                                                           FontWeight="Normal"
                                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>

                                                <!-- Subtle Native Windows Phone Audio Waveform Indicator -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Rectangle x:Name="HomeVoiceWave1" Width="2.5" Height="8" RadiusX="1" RadiusY="1" Fill="{ThemeResource AppVoiceRecordActiveBrush}" Opacity="0.7" Margin="0,0,2,0"/>
                                                    <Rectangle x:Name="HomeVoiceWave2" Width="2.5" Height="14" RadiusX="1" RadiusY="1" Fill="{ThemeResource AppVoiceRecordActiveBrush}" Opacity="0.9" Margin="0,0,2,0"/>
                                                    <Rectangle x:Name="HomeVoiceWave3" Width="2.5" Height="10" RadiusX="1" RadiusY="1" Fill="{ThemeResource AppVoiceRecordActiveBrush}" Opacity="0.75" Margin="0,0,2,0"/>
                                                    <Rectangle x:Name="HomeVoiceWave4" Width="2.5" Height="6" RadiusX="1" RadiusY="1" Fill="{ThemeResource AppVoiceRecordActiveBrush}" Opacity="0.6"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Bottom line: Live interim transcribed text (hypothesis) -->
                                            <TextBlock x:Name="HomeVoiceHypothesisText"
                                                       Grid.Row="1"
                                                       Text="Speak now..."
                                                       FontSize="12"
                                                       FontStyle="Italic"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"
                                                       Margin="0,2,0,0"/>
                                        </Grid>

                                        <!-- Column 2: Cancel Recording Button -->
                                        <Button x:Name="HomeCancelVoiceRecordingButton"
                                                Grid.Column="2"
                                                Style="{StaticResource WinAIIconButtonStyle}"
                                                Width="38"
                                                Height="38"
                                                VerticalAlignment="Center"
                                                Margin="0,0,4,0"
                                                Click="HomeCancelVoiceRecordingButton_Click"
                                                ToolTipService.ToolTip="Cancel">
                                            <TextBlock Text="&#xE711;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Column 3: Done Recording Button (Checkmark - puts text into composer without auto-sending) -->
                                        <Button x:Name="HomeDoneVoiceRecordingButton"
                                                Grid.Column="3"
                                                Style="{StaticResource WinAIIconButtonStyle}"
                                                Width="38"
                                                Height="38"
                                                VerticalAlignment="Center"
                                                Click="HomeDoneVoiceRecordingButton_Click"
                                                ToolTipService.ToolTip="Done (insert text)">
                                            <TextBlock Text="&#xE73E;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       Foreground="{ThemeResource AppAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Clear Model Unavailable Warning Banner (Requirement 10) -->
                            <Border x:Name="HomeModelUnavailableBanner"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource WinAIErrorBrush}"
                                    CornerRadius="10"
                                    Padding="12,8"
                                    Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE783;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               Foreground="White"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="HomeModelUnavailableText"
                                               Text="Your selected model is unavailable. Please select another model."
                                               FontSize="12.5"
                                               FontFamily="Segoe UI"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Home Voice Error / Status Banner -->
                            <Border x:Name="HomeVoiceStatusBanner"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource WinAIErrorBrush}"
                                    CornerRadius="10"
                                    Padding="12,8"
                                    Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="HomeVoiceStatusBannerIcon"
                                               Text="&#xE783;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               Foreground="White"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="HomeVoiceStatusBannerText"
                                               Text="Microphone permission is required."
                                               FontSize="12.5"
                                               FontFamily="Segoe UI"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               TextWrapping="WrapWholeWords"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Model Selector Dropdown Button below the hero input -->
                            <Button x:Name="HomeModelSelectorButton"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="0,0,0,28"
                                    HorizontalAlignment="Left">
                                <Border Background="{ThemeResource AppSurfaceBrush}"
                                        BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="10,5,12,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:WinAIProviderIcon x:Name="HomeModelProviderIcon"
                                                                    IconSize="18"
                                                                    BadgeCornerRadius="4"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center" />
                                    <TextBlock x:Name="HomeSelectedModelText"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="9.5"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               Margin="6,1,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                </Border>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="HomeModelPickerFlyout"
                                                MenuFlyoutPresenterStyle="{StaticResource ModernMenuFlyoutStyle}">
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Recent Section Header -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Recent"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Background="Transparent"
                                        Padding="4,2"
                                        Click="ViewAllConversations_Click">
                                    <TextBlock Text="View all &#x203A;"
                                               FontSize="13"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Button>
                            </Grid>

                            <!-- Recent Conversations Card Container -->
                            <Border CornerRadius="10"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,24">
                                <StackPanel>
                                    <!-- Conversation 1 -->
                                    <controls:ConversationListItem x:Name="Conv1Item"
                                                                   ItemClick="ConversationItem_Click" />
                                    <Border x:Name="Conv1Divider" Height="1" Background="{ThemeResource AppDividerBrush}" Margin="14,0" />

                                    <!-- Conversation 2 -->
                                    <controls:ConversationListItem x:Name="Conv2Item"
                                                                   ItemClick="ConversationItem_Click" />
                                    <Border x:Name="Conv2Divider" Height="1" Background="{ThemeResource AppDividerBrush}" Margin="14,0" />

                                    <!-- Conversation 3 -->
                                    <controls:ConversationListItem x:Name="Conv3Item"
                                                                   ItemClick="ConversationItem_Click" />

                                    <!-- Empty state indicator if no conversations exist yet -->
                                    <TextBlock x:Name="EmptyRecentMessageText"
                                               Text="No recent conversations yet. Ask anything above!"
                                               FontSize="13"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               Margin="16,14"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>
