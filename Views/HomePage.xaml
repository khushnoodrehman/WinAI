<Page
    x:Class="WinAI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinAI.Views"
    xmlns:controls="using:WinAI.Controls"
    xmlns:models="using:WinAI.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppPageBackgroundBrush}">

    <Grid>
        <!-- Overlay SplitView for Hamburger Navigation Drawer -->
        <SplitView x:Name="NavDrawer"
                   DisplayMode="Overlay"
                   PanePlacement="Left"
                   OpenPaneLength="310"
                   LightDismissOverlayMode="On"
                   PaneBackground="{ThemeResource AppDrawerBackgroundBrush}"
                   IsPaneOpen="False">

            <!-- ==================== LEFT DRAWER PANE ==================== -->
            <SplitView.Pane>
                <Grid Background="{ThemeResource AppDrawerBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="0,32,0,32">
                            <!-- Drawer Header -->
                            <StackPanel Margin="24,0,16,28">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Win"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="AI"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppAccentBrush}" />
                                </StackPanel>
                                <TextBlock Text="Your AI. Your Keys. Your Device."
                                           FontSize="13"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Primary Menu Items -->
                            <!-- 1. Home (Selected) -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="HomeItem_Click">
                                <Grid Background="{ThemeResource AppDrawerSelectedBrush}" Height="48">
                                    <!-- Blue vertical indicator on the far left -->
                                    <Border Width="3.5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Background="{ThemeResource AppAccentBrush}" />

                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppAccentBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Home"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 2. New Chat -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="NewChatItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE15F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="New Chat"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 3. Conversations -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="ConversationsItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8FD;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Conversations"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 4. AI Providers -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="AiProvidersItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80A;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="AI Providers"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 5. Key Vault -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="KeyVaultItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Key Vault"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 6. Prompt Kit -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="PromptKitItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7C3;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Prompt Kit"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Section Separator -->
                            <Border Height="1"
                                    Background="{ThemeResource AppDrawerDividerBrush}"
                                    Margin="24,14,24,14" />

                            <!-- Secondary Menu Items -->
                            <!-- 7. Settings -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="SettingsItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Settings"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 8. Privacy Center -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="PrivacyCenterItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEA18;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Privacy Center"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 9. About WinAI -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="AboutWinAiItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE946;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="About WinAI"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>

            <!-- ==================== MAIN PAGE VIEW ==================== -->
            <SplitView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top App Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Scrollable Page Content -->
                        <RowDefinition Height="*" />
                        <!-- Row 2: Bottom Application Navigation -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ==================== ROW 0: TOP APP BAR ==================== -->
                    <Grid Grid.Row="0"
                          Height="52"
                          Background="{ThemeResource AppTopBarBackgroundBrush}"
                          Padding="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Hamburger Menu Icon -->
                        <Button Grid.Column="0"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                Click="Hamburger_Click"
                                ToolTipService.ToolTip="Menu">
                            <TextBlock Text="&#xE700;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </Button>

                        <!-- Center/Left: "WinAI" Title -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Text="Win"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <TextBlock Text="AI"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource AppAccentBrush}" />
                        </StackPanel>

                        <!-- Right: Settings Gear Icon -->
                        <Button Grid.Column="2"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                Click="Settings_Click"
                                ToolTipService.ToolTip="Settings">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- ==================== ROW 1: SCROLLABLE CONTENT ==================== -->
                    <ScrollViewer Grid.Row="1"
                                  Padding="16,0,16,10"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Greeting Section -->
                            <StackPanel Margin="0,18,0,20">
                                <TextBlock x:Name="GreetingTitleText"
                                           Text="Good afternoon,"
                                           FontSize="26"
                                           FontWeight="Normal"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock Text="What would you like to do today?"
                                           FontSize="15"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Primary "Ask anything..." Action Surface -->
                            <Border CornerRadius="8"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                    BorderThickness="1"
                                    Padding="14,13"
                                    Margin="0,0,0,24"
                                    Tapped="AskAnything_Tapped"
                                    PointerEntered="AskAnything_PointerEntered"
                                    PointerExited="AskAnything_PointerExited">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Chat outline icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="&#xE8BD;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Center: Prompt placeholder text -->
                                    <TextBlock Grid.Column="1"
                                               Text="Ask anything..."
                                               FontSize="15"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />

                                    <!-- Right: Arrow icon -->
                                    <TextBlock Grid.Column="2"
                                               Text="&#xE72A;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- AI Providers Section Header -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="AI Providers"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Background="Transparent"
                                        Padding="4,2"
                                        Click="ManageProviders_Click">
                                    <TextBlock Text="Manage &#x203A;"
                                               FontSize="13"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Button>
                            </Grid>

                            <!-- AI Providers Card Container -->
                            <Border CornerRadius="10"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,24">
                                <StackPanel>
                                    <!-- OpenAI -->
                                    <controls:ProviderListItem x:Name="OpenAiItem"
                                                               ItemClick="ProviderItem_Click" />
                                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="14,0" />

                                    <!-- Gemini -->
                                    <controls:ProviderListItem x:Name="GeminiItem"
                                                               ItemClick="ProviderItem_Click" />
                                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="14,0" />

                                    <!-- Claude -->
                                    <controls:ProviderListItem x:Name="ClaudeItem"
                                                               ItemClick="ProviderItem_Click" />
                                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="14,0" />

                                    <!-- Perplexity -->
                                    <controls:ProviderListItem x:Name="PerplexityItem"
                                                               ItemClick="ProviderItem_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Recent Conversations Section Header -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Recent Conversations"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Background="Transparent"
                                        Padding="4,2"
                                        Click="ViewAllConversations_Click">
                                    <TextBlock Text="View all &#x203A;"
                                               FontSize="13"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Button>
                            </Grid>

                            <!-- Recent Conversations Card Container -->
                            <Border CornerRadius="10"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <!-- Conversation 1 -->
                                    <controls:ConversationListItem x:Name="Conv1Item"
                                                                   ItemClick="ConversationItem_Click" />
                                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="14,0" />

                                    <!-- Conversation 2 -->
                                    <controls:ConversationListItem x:Name="Conv2Item"
                                                                   ItemClick="ConversationItem_Click" />
                                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="14,0" />

                                    <!-- Conversation 3 -->
                                    <controls:ConversationListItem x:Name="Conv3Item"
                                                                   ItemClick="ConversationItem_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== ROW 2: BOTTOM APP NAVIGATION ==================== -->
                    <Border Grid.Row="2"
                            Height="56"
                            Background="{ThemeResource AppBottomNavBackgroundBrush}"
                            BorderBrush="{ThemeResource AppBottomNavBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tab 1: Home (Active) -->
                            <Button Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Padding="0">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="&#xE80F;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{ThemeResource AppAccentBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Home"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppAccentBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0" />
                                    <!-- Blue underline bar -->
                                    <Border Width="20"
                                            Height="2"
                                            Background="{ThemeResource AppAccentBrush}"
                                            CornerRadius="1"
                                            Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>

                            <!-- Tab 2: Chats -->
                            <Button Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Padding="0"
                                    Click="NavigateToChats_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8BD;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Chats"
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,4" />
                                </StackPanel>
                            </Button>

                            <!-- Tab 3: Vault -->
                            <Button Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Padding="0"
                                    Click="NavigateToVault_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="&#xE72E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Vault"
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,4" />
                                </StackPanel>
                            </Button>

                            <!-- Tab 4: More -->
                            <Button Grid.Column="3"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Padding="0"
                                    Click="MoreTab_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="&#xE700;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="More"
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,4" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>
