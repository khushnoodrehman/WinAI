<Page
    x:Class="WinAI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinAI.Views"
    xmlns:controls="using:WinAI.Controls"
    xmlns:models="using:WinAI.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppPageBackgroundBrush}">

    <Grid>
        <!-- Overlay SplitView for Hamburger Navigation Drawer -->
        <SplitView x:Name="NavDrawer"
                   DisplayMode="Overlay"
                   PanePlacement="Left"
                   OpenPaneLength="310"
                   LightDismissOverlayMode="On"
                   PaneBackground="{ThemeResource AppDrawerBackgroundBrush}"
                   IsPaneOpen="False">

            <!-- ==================== LEFT DRAWER PANE ==================== -->
            <SplitView.Pane>
                <Grid Background="{ThemeResource AppDrawerBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="0,32,0,32">
                            <!-- Drawer Header -->
                            <StackPanel Margin="24,0,16,28">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Win"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="AI"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppAccentBrush}" />
                                </StackPanel>
                                <TextBlock Text="Your AI. Your Keys. Your Device."
                                           FontSize="13"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Primary Menu Items -->
                            <!-- 1. Home (Selected) -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="HomeItem_Click">
                                <Grid Background="{ThemeResource AppDrawerSelectedBrush}" Height="48">
                                    <!-- Blue vertical indicator on the far left -->
                                    <Border Width="3.5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Background="{ThemeResource AppAccentBrush}" />

                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppAccentBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Home"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 2. New Chat -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="NewChatItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE15F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="New Chat"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 3. Conversations -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="ConversationsItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8FD;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Conversations"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 4. AI Providers -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="AiProvidersItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80A;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="AI Providers"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 5. Key Vault -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="KeyVaultItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Key Vault"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 6. Prompt Kit -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="PromptKitItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7C3;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Prompt Kit"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Section Separator -->
                            <Border Height="1"
                                    Background="{ThemeResource AppDrawerDividerBrush}"
                                    Margin="24,14,24,14" />

                            <!-- Secondary Menu Items -->
                            <!-- 7. Settings -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="SettingsItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Settings"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 8. Privacy Center -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="PrivacyCenterItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEA18;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Privacy Center"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 9. About WinAI -->
                            <Button Style="{StaticResource DrawerItemButtonStyle}"
                                    Click="AboutWinAiItem_Click">
                                <Grid Background="Transparent" Height="48">
                                    <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE946;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Foreground="{ThemeResource AppDrawerIconBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="About WinAI"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>

            <!-- ==================== MAIN PAGE VIEW ==================== -->
            <SplitView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top App Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Scrollable Page Content -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ==================== ROW 0: TOP APP BAR ==================== -->
                    <Grid Grid.Row="0"
                          Height="52"
                          Background="{ThemeResource AppTopBarBackgroundBrush}"
                          Padding="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Hamburger Menu Icon -->
                        <Button Grid.Column="0"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                Click="Hamburger_Click"
                                ToolTipService.ToolTip="Menu">
                            <TextBlock Text="&#xE700;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </Button>

                        <!-- Center/Left: "WinAI" Title -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Text="Win"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <TextBlock Text="AI"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource AppAccentBrush}" />
                        </StackPanel>

                        <!-- Right: Settings Gear Icon -->
                        <Button Grid.Column="2"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                Click="Settings_Click"
                                ToolTipService.ToolTip="Settings">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- ==================== ROW 1: SCROLLABLE CONTENT ==================== -->
                    <ScrollViewer Grid.Row="1"
                                  Padding="20,0,20,24"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Greeting & AI Launcher Hero Section -->
                            <StackPanel Margin="0,20,0,16">
                                <TextBlock x:Name="GreetingTitleText"
                                           Text="Good morning."
                                           FontSize="18"
                                           FontWeight="Normal"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                <TextBlock Text="What's on your mind?"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Modern Translucent Launcher Composer Bar matching Screenshot 2 & 3 -->
                            <Border Background="{ThemeResource AppTranslucentBarBrush}"
                                    BorderBrush="{ThemeResource AppTranslucentBarBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="24"
                                    MinHeight="46"
                                    Padding="6,2,6,2"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <!-- State 1: Normal Input Bar (Screenshot 2) -->
                                    <Grid x:Name="HomeNormalInputGrid" Visibility="Visible">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: + Button -->
                                        <Button Grid.Column="0"
                                                Width="38"
                                                Height="38"
                                                Background="Transparent"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Click="NewChatItem_Click"
                                                ToolTipService.ToolTip="New Chat">
                                            <TextBlock Text="&#xE710;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="19"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Center: Input Box (Transparent, never white on focus) -->
                                        <TextBox x:Name="HomePromptTextBox"
                                                 Grid.Column="1"
                                                 PlaceholderText="Type a message"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="36"
                                                 MaxHeight="96"
                                                 InputScope="Chat"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontSize="15"
                                                 FontFamily="Segoe UI"
                                                 Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="4,0,4,0"
                                                 KeyDown="HomePromptTextBox_KeyDown"
                                                 TextChanged="HomePromptTextBox_TextChanged">
                                            <TextBox.Resources>
                                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                                <StaticResource x:Key="TextControlForeground" ResourceKey="AppTextPrimaryBrush" />
                                                <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="AppTextPrimaryBrush" />
                                                <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="AppTextPrimaryBrush" />
                                                <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="AppTextSecondaryBrush" />
                                                <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="AppTextSecondaryBrush" />
                                                <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="AppTextSecondaryBrush" />
                                            </TextBox.Resources>
                                        </TextBox>

                                        <!-- Right 1: Voice Microphone Button (Green in Screenshot 2) -->
                                        <Button x:Name="HomeVoiceRecordButton"
                                                Grid.Column="2"
                                                Width="38"
                                                Height="38"
                                                Background="Transparent"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Click="HomeVoiceRecordButton_Click"
                                                ToolTipService.ToolTip="Voice message">
                                            <TextBlock Text="&#xE720;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="19"
                                                       Foreground="{ThemeResource AppSendGreenBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Right 2: Send Button (Paper-plane outline in Screenshot 2) -->
                                        <Button x:Name="HomeSendButton"
                                                Grid.Column="3"
                                                Width="38"
                                                Height="38"
                                                Background="Transparent"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Click="HomeSendButton_Click"
                                                ToolTipService.ToolTip="Send prompt">
                                            <TextBlock Text="&#xE724;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       Foreground="{ThemeResource AppSendGreenBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>

                                    <!-- State 2: Active Voice Recording Bar (Screenshot 3) -->
                                    <Grid x:Name="HomeVoiceRecordingGrid" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Red Mic Icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE720;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20"
                                                   Foreground="{ThemeResource AppVoiceRecordActiveBrush}"
                                                   Margin="10,0,10,0"
                                                   VerticalAlignment="Center"/>

                                        <!-- Timer (0:01 etc.) -->
                                        <TextBlock x:Name="HomeVoiceRecordingTimerText"
                                                   Grid.Column="1"
                                                   Text="0:00"
                                                   FontSize="16"
                                                   FontFamily="Segoe UI"
                                                   FontWeight="Normal"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Right 1: Trash / Cancel Recording Button -->
                                        <Button x:Name="HomeCancelVoiceRecordingButton"
                                                Grid.Column="2"
                                                Width="38"
                                                Height="38"
                                                Background="Transparent"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Margin="0,0,4,0"
                                                Click="HomeCancelVoiceRecordingButton_Click"
                                                ToolTipService.ToolTip="Cancel recording">
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Right 2: Send Recording (Transcribes and sends directly into chat!) -->
                                        <Button x:Name="HomeSendVoiceRecordingButton"
                                                Grid.Column="3"
                                                Width="38"
                                                Height="38"
                                                Background="Transparent"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Click="HomeSendVoiceRecordingButton_Click"
                                                ToolTipService.ToolTip="Transcribe and send">
                                            <TextBlock Text="&#xE724;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       Foreground="{ThemeResource AppSendGreenBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Model Selector Dropdown Button below the hero input -->
                            <Button x:Name="HomeModelSelectorButton"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="0,0,0,28"
                                    HorizontalAlignment="Left">
                                <Border Background="{ThemeResource AppSurfaceBrush}"
                                        BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="10,5,12,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="HomeModelIconContainer"
                                            Width="18"
                                            Height="18"
                                            CornerRadius="4"
                                            Background="#10A37F"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="HomeModelIconGlyph"
                                                   Text="&#xE8BD;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="HomeSelectedModelText"
                                               Text="GPT-4o"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="9.5"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               Margin="6,1,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                </Border>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="HomeModelPickerFlyout">
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Recent Section Header -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Recent"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Background="Transparent"
                                        Padding="4,2"
                                        Click="ViewAllConversations_Click">
                                    <TextBlock Text="View all &#x203A;"
                                               FontSize="13"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Button>
                            </Grid>

                            <!-- Recent Conversations Card Container -->
                            <Border CornerRadius="10"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,24">
                                <StackPanel>
                                    <!-- Conversation 1 -->
                                    <controls:ConversationListItem x:Name="Conv1Item"
                                                                   ItemClick="ConversationItem_Click" />
                                    <Border x:Name="Conv1Divider" Height="1" Background="{ThemeResource AppDividerBrush}" Margin="14,0" />

                                    <!-- Conversation 2 -->
                                    <controls:ConversationListItem x:Name="Conv2Item"
                                                                   ItemClick="ConversationItem_Click" />
                                    <Border x:Name="Conv2Divider" Height="1" Background="{ThemeResource AppDividerBrush}" Margin="14,0" />

                                    <!-- Conversation 3 -->
                                    <controls:ConversationListItem x:Name="Conv3Item"
                                                                   ItemClick="ConversationItem_Click" />

                                    <!-- Empty state indicator if no conversations exist yet -->
                                    <TextBlock x:Name="EmptyRecentMessageText"
                                               Text="No recent conversations yet. Ask anything above!"
                                               FontSize="13"
                                               FontFamily="Segoe UI"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               Margin="16,14"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>
