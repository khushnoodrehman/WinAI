<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- ==================== DARK THEME (DEFAULT) ==================== -->
        <ResourceDictionary x:Key="Default">
            <!-- Backgrounds -->
            <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="#0B0C0E" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#16181C" />
            <SolidColorBrush x:Key="AppSurfaceBorderBrush" Color="#22252B" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#1D2026" />
            <SolidColorBrush x:Key="AppItemPressedBrush" Color="#20232A" />

            <!-- Text Colors -->
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#8E929B" />
            <SolidColorBrush x:Key="AppTextMutedBrush" Color="#5A5E68" />

            <!-- Accent & Nav -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D7" />
            <SolidColorBrush x:Key="AppAccentLightBrush" Color="#268FE6" />
            <SolidColorBrush x:Key="AppTopBarBackgroundBrush" Color="#0B0C0E" />
            <SolidColorBrush x:Key="AppBottomNavBackgroundBrush" Color="#0B0C0E" />
            <SolidColorBrush x:Key="AppBottomNavBorderBrush" Color="#181A1F" />

            <!-- Navigation Drawer Brushes (Dark Theme) -->
            <SolidColorBrush x:Key="AppDrawerBackgroundBrush" Color="#0E1014" />
            <SolidColorBrush x:Key="AppDrawerSelectedBrush" Color="#12253B" />
            <SolidColorBrush x:Key="AppDrawerIconBrush" Color="#8E939E" />
            <SolidColorBrush x:Key="AppDrawerDividerBrush" Color="#1B1F27" />

            <!-- Chat Bubble & Pill Surfaces -->
            <SolidColorBrush x:Key="AppUserBubbleBrush" Color="#182230" />
            <SolidColorBrush x:Key="AppUserBubbleBorderBrush" Color="#243346" />
            <SolidColorBrush x:Key="AppAiBubbleBrush" Color="#151921" />
            <SolidColorBrush x:Key="AppAiBubbleBorderBrush" Color="#202732" />
            <SolidColorBrush x:Key="AppInputPillBrush" Color="#1A1E24" />
            <SolidColorBrush x:Key="AppInputPillBorderBrush" Color="#242A33" />

            <!-- Modern Translucent Input Bar & Voice Controls -->
            <SolidColorBrush x:Key="AppTranslucentBarBrush" Color="#DD141820" />
            <SolidColorBrush x:Key="AppTranslucentBarBorderBrush" Color="#442E3544" />
            <SolidColorBrush x:Key="AppVoiceRecordActiveBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="AppSendGreenBrush" Color="#10B981" />
        </ResourceDictionary>

        <!-- ==================== LIGHT THEME ==================== -->
        <ResourceDictionary x:Key="Light">
            <!-- Backgrounds -->
            <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="#F8F9FA" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F0F2F5" />
            <SolidColorBrush x:Key="AppSurfaceBorderBrush" Color="#E2E5E9" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#E5E8ED" />
            <SolidColorBrush x:Key="AppItemPressedBrush" Color="#E4E7EB" />

            <!-- Navigation Drawer Brushes (Light Theme) -->
            <SolidColorBrush x:Key="AppDrawerBackgroundBrush" Color="#F6F8FB" />
            <SolidColorBrush x:Key="AppDrawerSelectedBrush" Color="#E6F0FA" />
            <SolidColorBrush x:Key="AppDrawerIconBrush" Color="#646D7D" />
            <SolidColorBrush x:Key="AppDrawerDividerBrush" Color="#E4E8EE" />

            <!-- Text Colors -->
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#1A1D20" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#727782" />
            <SolidColorBrush x:Key="AppTextMutedBrush" Color="#9FA4AF" />

            <!-- Accent & Nav -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D7" />
            <SolidColorBrush x:Key="AppAccentLightBrush" Color="#0078D7" />
            <SolidColorBrush x:Key="AppTopBarBackgroundBrush" Color="#F8F9FA" />
            <SolidColorBrush x:Key="AppBottomNavBackgroundBrush" Color="#F8F9FA" />
            <SolidColorBrush x:Key="AppBottomNavBorderBrush" Color="#E5E8ED" />

            <!-- Chat Bubble & Pill Surfaces -->
            <SolidColorBrush x:Key="AppUserBubbleBrush" Color="#E2EAF4" />
            <SolidColorBrush x:Key="AppUserBubbleBorderBrush" Color="#D2DFEF" />
            <SolidColorBrush x:Key="AppAiBubbleBrush" Color="#EFF2F6" />
            <SolidColorBrush x:Key="AppAiBubbleBorderBrush" Color="#DFE4EA" />
            <SolidColorBrush x:Key="AppInputPillBrush" Color="#EEF2F6" />
            <SolidColorBrush x:Key="AppInputPillBorderBrush" Color="#DEE3E8" />

            <!-- Modern Translucent Input Bar & Voice Controls -->
            <SolidColorBrush x:Key="AppTranslucentBarBrush" Color="#EEEDF2F7" />
            <SolidColorBrush x:Key="AppTranslucentBarBorderBrush" Color="#44C8D2DE" />
            <SolidColorBrush x:Key="AppVoiceRecordActiveBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="AppSendGreenBrush" Color="#059669" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Global Static Colors -->
    <Color x:Key="WindowsBlueColor">#0078D7</Color>
    <SolidColorBrush x:Key="WindowsBlueBrush" Color="#0078D7" />

    <!-- Drawer Navigation Item Button Style -->
    <Style x:Key="DrawerItemButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppItemPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppItemPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
