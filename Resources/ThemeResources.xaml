            <!-- Text Colors -->
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#8E929B" />
            <SolidColorBrush x:Key="AppTextMutedBrush" Color="#5A5E68" />

            <!-- Accent & Nav (Dynamically resolves to Windows Phone system accent color) -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AppAccentLightBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AppTopBarBackgroundBrush" Color="#0B0C0E" />
            <SolidColorBrush x:Key="AppBottomNavBackgroundBrush" Color="#0B0C0E" />
            <SolidColorBrush x:Key="AppBottomNavBorderBrush" Color="#181A1F" />

            <!-- Navigation Drawer Brushes (Dark Theme) -->
            <SolidColorBrush x:Key="AppDrawerBackgroundBrush" Color="#0E1014" />
            <SolidColorBrush x:Key="AppDrawerSelectedBrush" Color="#12253B" />
            <SolidColorBrush x:Key="AppDrawerIconBrush" Color="#8E939E" />
            <SolidColorBrush x:Key="AppDrawerDividerBrush" Color="#1B1F27" />

            <!-- Chat Bubble & Pill Surfaces -->
            <SolidColorBrush x:Key="AppUserBubbleBrush" Color="#182230" />
            <SolidColorBrush x:Key="AppUserBubbleBorderBrush" Color="#243346" />
            <SolidColorBrush x:Key="AppAiBubbleBrush" Color="#151921" />
            <SolidColorBrush x:Key="AppAiBubbleBorderBrush" Color="#202732" />
            <SolidColorBrush x:Key="AppInputPillBrush" Color="#1A1E24" />
            <SolidColorBrush x:Key="AppInputPillBorderBrush" Color="#242A33" />

            <!-- Modern Translucent Input Bar & Voice Controls -->
            <SolidColorBrush x:Key="AppTranslucentBarBrush" Color="#DD141820" />
            <SolidColorBrush x:Key="AppTranslucentBarBorderBrush" Color="#442E3544" />
            <SolidColorBrush x:Key="AppVoiceRecordActiveBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="AppSendGreenBrush" Color="#10B981" />
            <SolidColorBrush x:Key="AppButtonBackgroundBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AppButtonForegroundBrush" Color="#FFFFFF" />

            <!-- Standardized WinAI Semantic Theme System (Dark) -->
            <SolidColorBrush x:Key="WinAIBackgroundBrush" Color="#0B0C0E" />
            <SolidColorBrush x:Key="WinAISurfaceBrush" Color="#16181C" />
            <SolidColorBrush x:Key="WinAISurfaceBorderBrush" Color="#22252B" />
            <SolidColorBrush x:Key="WinAIForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="WinAISubtleForegroundBrush" Color="#8E929B" />
            <SolidColorBrush x:Key="WinAIMutedForegroundBrush" Color="#5A5E68" />
            <SolidColorBrush x:Key="WinAIDividerBrush" Color="#1D2026" />
            <SolidColorBrush x:Key="WinAIAccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="WinAIErrorBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="SystemControlErrorCautionAccentBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="WinAISuccessBrush" Color="#10B981" />
            <SolidColorBrush x:Key="WinAIInputBackgroundBrush" Color="#16181C" />
            <SolidColorBrush x:Key="WinAIInputBorderBrush" Color="#22252B" />
            <SolidColorBrush x:Key="WinAISelectedBrush" Color="#12253B" />
            <SolidColorBrush x:Key="WinAIPressedBrush" Color="#20232A" />

            <!-- Standard UWP ListViewItem / ListViewItemPresenter Theme Brushes (Dark) -->
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#20232A" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#12253B" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#20232A" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#1A1D24" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#162E49" />
        </ResourceDictionary>

        <!-- ==================== LIGHT THEME ==================== -->
        <ResourceDictionary x:Key="Light">
            <!-- Backgrounds -->
            <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="#F8F9FA" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F0F2F5" />
            <SolidColorBrush x:Key="AppSurfaceBorderBrush" Color="#E2E5E9" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#E5E8ED" />
