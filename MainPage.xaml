<Page
    x:Class="WinAI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinAI"
    xmlns:models="using:WinAI.Models"
    xmlns:common="using:WinAI.Common"
    xmlns:controls="using:WinAI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppPageBackgroundBrush}">

    <Page.Resources>
        <!-- ==================== USER MESSAGE TEMPLATE (RIGHT) ==================== -->
        <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:ChatMessage">
            <Grid HorizontalAlignment="Right" Margin="32,4,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- User Message Bubble -->
                <Border Grid.Column="0"
                        HorizontalAlignment="Right"
                        Background="{ThemeResource AppUserBubbleBrush}"
                        BorderBrush="{ThemeResource AppUserBubbleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="13,10,13,8"
                        MaxWidth="270">
                    <StackPanel>
                        <!-- Attached Image preview in chat bubble -->
                        <Image Source="{x:Bind ImageSource, Mode=OneWay}"
                               Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                               MaxHeight="200"
                               MaxWidth="244"
                               Stretch="Uniform"
                               Margin="0,0,0,6"/>

                        <TextBlock Text="{x:Bind Text}"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="14.5"
                                   LineHeight="20"
                                   IsTextSelectionEnabled="True"/>

                        <!-- Timestamp + Blue Read Receipts -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,5,0,0">
                            <TextBlock Text="{x:Bind FormattedTime}"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       Opacity="0.75"
                                       FontSize="10.5"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center"/>
                            <!-- Double checkmark in Windows Blue -->
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{ThemeResource AppAccentBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- User Person Avatar Circle on the right -->
                <Border Grid.Column="1"
                        Width="28"
                        Height="28"
                        CornerRadius="14"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Top"
                        Margin="8,2,0,0">
                    <TextBlock Text="&#xE77B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ==================== AI MESSAGE TEMPLATE (LEFT) ==================== -->
        <DataTemplate x:Key="AiMessageTemplate" x:DataType="models:ChatMessage">
            <Grid HorizontalAlignment="Left" Margin="0,4,32,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- AI Provider Icon -->
                <controls:ProviderIcon Grid.Column="0"
                                       ProviderId="{x:Bind ProviderId, Mode=OneWay}"
                                       IconSize="28"
                                       BadgeCornerRadius="7"
                                       VerticalAlignment="Top"
                                       Margin="0,2,8,0"/>

                <!-- AI Message Bubble + Action Row -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                    <!-- Bubble Surface -->
                    <Border Background="{ThemeResource AppAiBubbleBrush}"
                            BorderBrush="{ThemeResource AppAiBubbleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,12,14,10"
                            MaxWidth="285">
                        <StackPanel>
                            <!-- Subtle Model Identity Header for Assistant Responses -->
                            <TextBlock Text="{x:Bind SenderName, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppAccentBrush}"
                                       Margin="0,0,0,4"
                                       Opacity="0.85"/>

                            <!-- Dynamic Markdown Formatted Text -->
                            <RichTextBlock common:MarkdownRenderer.Markdown="{x:Bind Text}"
                                           FontSize="14"
                                           LineHeight="20"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           IsTextSelectionEnabled="True"
                                           TextWrapping="Wrap"/>

                            <!-- Timestamp and Copy Icon -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FormattedTime}"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               Opacity="0.75"
                                               FontSize="10.5"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <Button Background="Transparent"
                                            Padding="0"
                                            Width="18"
                                            Height="18"
                                            Tag="{x:Bind Text}"
                                            Click="CopyMessage_Click">
                                        <TextBlock Text="&#xE8C8;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Compact Action Pill Row (Copy, Like, Dislike, More) -->
                    <Border CornerRadius="8"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,4"
                            Padding="4,2">
                        <StackPanel Orientation="Horizontal">
                            <Button Width="30" Height="26" Background="Transparent" Padding="0"
                                    Tag="{x:Bind Text}" Click="CopyMessage_Click" ToolTipService.ToolTip="Copy">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                            </Button>
                            <Button Width="30" Height="26" Background="Transparent" Padding="0"
                                    Click="LikeMessage_Click" ToolTipService.ToolTip="Like">
                                <TextBlock Text="&#xE8E1;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                            </Button>
                            <Button Width="30" Height="26" Background="Transparent" Padding="0"
                                    Click="DislikeMessage_Click" ToolTipService.ToolTip="Dislike">
                                <TextBlock Text="&#xE8E0;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                            </Button>
                            <Button Width="30" Height="26" Background="Transparent" Padding="0"
                                    Click="MoreMessageAction_Click" ToolTipService.ToolTip="More">
                                <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ==================== SYSTEM / MODEL SWITCH DIVIDER ==================== -->
        <DataTemplate x:Key="SystemMessageTemplate" x:DataType="models:ChatMessage">
            <Grid HorizontalAlignment="Stretch" Margin="16,10,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="1" Background="{ThemeResource AppDividerBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.85">
                    <controls:ProviderIcon ProviderId="{x:Bind ProviderId, Mode=OneWay}"
                                           IconSize="16"
                                           BadgeCornerRadius="4"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind Text}"
                               FontSize="11.5"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="2" Height="1" Background="{ThemeResource AppDividerBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </DataTemplate>

        <!-- Template Selector -->
        <common:ChatMessageTemplateSelector x:Key="MessageTemplateSelector"
            UserMessageTemplate="{StaticResource UserMessageTemplate}"
            AiMessageTemplate="{StaticResource AiMessageTemplate}"
            SystemMessageTemplate="{StaticResource SystemMessageTemplate}"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Top App Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Chat Feed Area -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Message Composer Area -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: TOP APP BAR ==================== -->
        <Grid Grid.Row="0"
              Height="54"
              Background="{ThemeResource AppTopBarBackgroundBrush}"
              BorderBrush="{ThemeResource AppDividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Back Button + Provider Icon + Title & Model Selector -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Back Button -->
                <Button Width="36"
                        Height="36"
                        Background="Transparent"
                        Click="HeaderBackButton_Click"
                        Margin="0,0,6,0"
                        ToolTipService.ToolTip="Back">
                    <TextBlock Text="&#xE72B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                </Button>

                <!-- Interactive Model Selector Button -->
                <Button x:Name="ModelSelectorButton"
                        Background="Transparent"
                        Padding="4,2,8,2"
                        Margin="0"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Switch AI">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Reusable Provider Brand Icon -->
                        <controls:ProviderIcon x:Name="HeaderProviderIcon"
                                               ProviderId="openai"
                                               IconSize="32"
                                               BadgeCornerRadius="7"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>

                        <!-- Model Name on top + Provider Subtitle with chevron on bottom -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedModelHeaderText"
                                       Text="GPT-4o"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock x:Name="SelectedProviderHeaderText"
                                           Text="OpenAI"
                                           FontSize="11.5"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                                <TextBlock x:Name="KeyRequiredHeaderWarning"
                                           Text=" • Key required"
                                           FontSize="11"
                                           Foreground="{ThemeResource AppAccentBrush}"
                                           Visibility="Collapsed"/>
                                <TextBlock Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="8"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           Margin="4,2,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Button.Flyout>
                        <Flyout x:Name="SwitchAiFlyout" Placement="Bottom" Opening="SwitchAiFlyout_Opening">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="{ThemeResource AppDividerBrush}"/>
                                    <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}"/>
                                    <Setter Property="MinWidth" Value="280"/>
                                    <Setter Property="MaxWidth" Value="320"/>
                                    <Setter Property="MaxHeight" Value="420"/>
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Grid Width="280">
                                <Grid.RowDefinitions>
                                    <!-- Header -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Separator -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- List -->
                                    <RowDefinition Height="*"/>
                                    <!-- Footer -->
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header: "Switch AI" -->
                                <Grid Grid.Row="0" Padding="16,12,16,10">
                                    <TextBlock Text="Switch AI"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                                </Grid>

                                <!-- Subtle Separator -->
                                <Border Grid.Row="1" Height="1" Background="{ThemeResource AppDividerBrush}"/>

                                <!-- Scrollable Model List -->
                                <ScrollViewer Grid.Row="2" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="SwitchAiModelList" Padding="0,4"/>
                                </ScrollViewer>

                                <!-- Footer: Key Vault & Settings -->
                                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource AppDividerBrush}">
                                    <Button x:Name="ManageKeysFlyoutButton"
                                            Background="Transparent"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="14,10"
                                            Click="ManageKeysFlyoutButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8D7;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource AppAccentBrush}"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Key Vault &amp; API Keys"
                                                       FontSize="12.5"
                                                       Foreground="{ThemeResource AppAccentBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!-- Right: Three-dot Overflow Menu -->
            <Button Grid.Column="1"
                    Width="38"
                    Height="38"
                    Background="Transparent"
                    ToolTipService.ToolTip="More Options">
                <TextBlock Text="&#xE712;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="New Chat" Click="NewChat_Click" />
                        <MenuFlyoutItem Text="Clear Chat" Click="ClearChat_Click" />
                        <MenuFlyoutItem Text="Copy Conversation" Click="CopyConversation_Click" />
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Settings &amp; Keys" Click="OpenSettings_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- ==================== ROW 1: CHAT FEED AREA ==================== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- Centered "Today" Date Separator -->
                <RowDefinition Height="Auto"/>
                <!-- Messages ListView -->
                <RowDefinition Height="*"/>
                <!-- Progress Ring / Typing indicator bubble -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Date Separator: ─── Today ─── -->
            <Grid Grid.Row="0" Margin="16,12,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="1" Background="{ThemeResource AppDividerBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Text="Today" FontSize="11.5" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Height="1" Background="{ThemeResource AppDividerBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>

            <!-- ListView for Messages -->
            <ListView x:Name="ChatListView"
                      Grid.Row="1"
                      ItemsSource="{x:Bind Messages}"
                      ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                      SelectionMode="None"
                      Padding="12,4,12,4">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,2,0,2"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Transient Model Switch Toast (Temporary Notification Pill) -->
            <Border x:Name="ModelSwitchToast"
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12,5"
                    Visibility="Collapsed"
                    Canvas.ZIndex="100">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:ProviderIcon x:Name="SwitchToastIcon"
                                           ProviderId="openai"
                                           IconSize="16"
                                           BadgeCornerRadius="4"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                    <TextBlock x:Name="SwitchToastText"
                               Text="Switched to Gemini"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Typing / Progress Indicator Bubble -->
            <Border x:Name="TypingIndicatorBubble"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource AppAiBubbleBrush}"
                    BorderBrush="{ThemeResource AppAiBubbleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,8"
                    Margin="14,0,48,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressRing x:Name="TypingProgressRing"
                                  IsActive="False"
                                  Width="16"
                                  Height="16"
                                  Foreground="{ThemeResource AppAccentBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"/>
                    <TextBlock x:Name="TypingIndicatorText"
                               Text="AI is thinking..."
                               FontSize="12"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== ROW 2: MESSAGE COMPOSER ==================== -->
        <Grid Grid.Row="2"
              Background="{ThemeResource AppPageBackgroundBrush}"
              Padding="12,6,12,8">
            <Grid.RowDefinitions>
                <!-- Attachment preview -->
                <RowDefinition Height="Auto"/>
                <!-- Voice Banner -->
                <RowDefinition Height="Auto"/>
                <!-- Input row -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Attachment Preview Bar -->
            <Border x:Name="AttachmentPreviewBar"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,6"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="AttachmentThumbnailImage"
                           Grid.Column="0"
                           Width="40"
                           Height="40"
                           Stretch="UniformToFill"
                           Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AttachmentFileNameText"
                                   Text="Image Attached"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Ready for Vision Analysis"
                                   FontSize="10.5"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Width="30"
                            Height="30"
                            Background="Transparent"
                            Click="RemoveAttachment_Click">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Voice Status Banner -->
            <Border x:Name="VoiceStatusBanner"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{ThemeResource AppAccentBrush}"
                    CornerRadius="6"
                    Padding="10,6"
                    Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Listening... Speak into microphone" FontSize="12" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Main Composer Row: Pill Input Box + Circular Blue Send Button -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pill Input Surface -->
                <Border Grid.Column="0"
                        Background="{ThemeResource AppInputPillBrush}"
                        BorderBrush="{ThemeResource AppInputPillBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="23"
                        MinHeight="46"
                        Padding="6,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Attachment / Paperclip button with Flyout (Gallery & Voice) -->
                        <Button Grid.Column="0"
                                Width="36"
                                Height="36"
                                Background="Transparent"
                                Padding="0"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Attach or Dictate">
                            <TextBlock Text="&#xE723;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Attach Image" Click="AttachImage_Click" />
                                    <MenuFlyoutItem Text="Voice Typing" Click="VoiceDictation_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Center: Multiline Input Box -->
                        <TextBox x:Name="InputTextBox"
                                 Grid.Column="1"
                                 PlaceholderText="Type your message..."
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="38"
                                 MaxHeight="100"
                                 InputScope="Chat"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{ThemeResource AppTextPrimaryBrush}"
                                 VerticalAlignment="Center"
                                 TextChanged="InputTextBox_TextChanged"
                                 KeyDown="InputTextBox_KeyDown"/>
                    </Grid>
                </Border>

                <!-- Right: Circular Blue Send Button -->
                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Width="46"
                        Height="46"
                        Margin="8,0,0,0"
                        Background="Transparent"
                        Padding="0"
                        Click="SendButton_Click"
                        ToolTipService.ToolTip="Send message">
                    <Border Width="46"
                            Height="46"
                            CornerRadius="23"
                            Background="{ThemeResource AppAccentBrush}">
                        <TextBlock Text="&#xE724;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
