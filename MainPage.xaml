<Page
    x:Class="WinAI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinAI"
    xmlns:models="using:WinAI.Models"
    xmlns:common="using:WinAI.Common"
    xmlns:controls="using:WinAI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppPageBackgroundBrush}">

    <Page.Resources>
        <!-- ==================== USER MESSAGE TEMPLATE (RIGHT) ==================== -->
        <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:ChatMessage">
            <Grid HorizontalAlignment="Right" Margin="48,4,0,6">
                <!-- User Message Bubble -->
                <Border HorizontalAlignment="Right"
                        Background="{ThemeResource AppUserBubbleBrush}"
                        BorderBrush="{ThemeResource AppUserBubbleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="13,10,13,8"
                        MaxWidth="290">
                    <StackPanel>
                        <!-- Attached Image preview in chat bubble -->
                        <Border Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                                CornerRadius="8"
                                Margin="0,0,0,6"
                                MaxHeight="220"
                                MaxWidth="264"
                                Background="{ThemeResource AppSurfaceBrush}"
                                Tag="{x:Bind}"
                                Tapped="MessageImage_Tapped">
                            <Grid MinWidth="140" MinHeight="80">
                                <!-- Loading Progress -->
                                <ProgressRing IsActive="{x:Bind IsImageLoading, Mode=OneWay}"
                                              Visibility="{x:Bind IsImageLoading, Mode=OneWay}"
                                              Width="28" Height="28"
                                              Foreground="{ThemeResource AppAccentBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                                <!-- Loaded Image -->
                                <Image Source="{x:Bind ImageSource, Mode=OneWay}"
                                       MaxHeight="220"
                                       MaxWidth="264"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                                <!-- Failed / Missing File Fallback -->
                                <StackPanel Visibility="{x:Bind IsImageFailed, Mode=OneWay}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Padding="16,12">
                                    <TextBlock Text="&#xEB9F;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="22"
                                               Foreground="{ThemeResource AppTextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Image unavailable"
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="{x:Bind Text}"
                                   Visibility="{x:Bind TextVisibility, Mode=OneWay}"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="14.5"
                                   LineHeight="20"
                                   IsTextSelectionEnabled="True"/>

                        <!-- Clean Timestamp (no messenger ticks) -->
                        <TextBlock Text="{x:Bind FormattedTime}"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   Opacity="0.75"
                                   FontSize="10.5"
                                   HorizontalAlignment="Right"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ==================== AI MESSAGE TEMPLATE (LEFT) ==================== -->
        <DataTemplate x:Key="AiMessageTemplate" x:DataType="models:ChatMessage">
            <Grid HorizontalAlignment="Left" Margin="0,4,32,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- AI Provider Icon -->
                <controls:ProviderIcon Grid.Column="0"
                                       ProviderId="{x:Bind ProviderId, Mode=OneWay}"
                                       IconSize="28"
                                       BadgeCornerRadius="7"
                                       VerticalAlignment="Top"
                                       Margin="0,2,8,0"/>

                <!-- AI Message Bubble + Action Row -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                    <!-- Bubble Surface -->
                    <Border Background="{ThemeResource AppAiBubbleBrush}"
                            BorderBrush="{ThemeResource AppAiBubbleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,12,14,10"
                            MaxWidth="285">
                        <StackPanel>
                            <!-- Subtle Model Identity Header for Assistant Responses -->
                            <TextBlock Text="{x:Bind SenderName, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppAccentBrush}"
                                       Margin="0,0,0,4"
                                       Opacity="0.85"/>

                            <!-- Attached / Generated Image preview in AI bubble -->
                            <Border Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                                    CornerRadius="8"
                                    Margin="0,0,0,6"
                                    MaxHeight="220"
                                    MaxWidth="264"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    Tag="{x:Bind}"
                                    Tapped="MessageImage_Tapped">
                                <Grid MinWidth="140" MinHeight="80">
                                    <!-- Loading Progress -->
                                    <ProgressRing IsActive="{x:Bind IsImageLoading, Mode=OneWay}"
                                                  Visibility="{x:Bind IsImageLoading, Mode=OneWay}"
                                                  Width="28" Height="28"
                                                  Foreground="{ThemeResource AppAccentBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                                    <!-- Loaded Image -->
                                    <Image Source="{x:Bind ImageSource, Mode=OneWay}"
                                           MaxHeight="220"
                                           MaxWidth="264"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                    <!-- Failed / Missing File Fallback -->
                                    <StackPanel Visibility="{x:Bind IsImageFailed, Mode=OneWay}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Padding="16,12">
                                        <TextBlock Text="&#xEB9F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="22"
                                                   Foreground="{ThemeResource AppTextMutedBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Image unavailable"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource AppTextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Dynamic Markdown Formatted Text -->
                            <RichTextBlock common:MarkdownRenderer.Markdown="{x:Bind Text}"
                                           Visibility="{x:Bind TextVisibility, Mode=OneWay}"
                                           FontSize="14"
                                           LineHeight="20"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           IsTextSelectionEnabled="True"
                                           TextWrapping="Wrap"/>

                            <!-- Timestamp and Copy Icon -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FormattedTime}"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               Opacity="0.75"
                                               FontSize="10.5"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <Button Background="Transparent"
                                            Padding="0"
                                            Width="18"
                                            Height="18"
                                            Tag="{x:Bind Text}"
                                            Click="CopyMessage_Click">
                                        <TextBlock Text="&#xE8C8;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ==================== SYSTEM / MODEL SWITCH DIVIDER ==================== -->
        <DataTemplate x:Key="SystemMessageTemplate" x:DataType="models:ChatMessage">
            <Grid HorizontalAlignment="Stretch" Margin="16,10,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="1" Background="{ThemeResource AppDividerBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.85">
                    <controls:WinAIProviderIcon ProviderId="{x:Bind ProviderId, Mode=OneWay}"
                                           IconSize="16"
                                           BadgeCornerRadius="4"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind Text}"
                               FontSize="11.5"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="2" Height="1" Background="{ThemeResource AppDividerBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </DataTemplate>

        <!-- Template Selector -->
        <common:ChatMessageTemplateSelector x:Key="MessageTemplateSelector"
            UserMessageTemplate="{StaticResource UserMessageTemplate}"
            AiMessageTemplate="{StaticResource AiMessageTemplate}"
            SystemMessageTemplate="{StaticResource SystemMessageTemplate}"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Top App Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Chat Feed Area -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Message Composer Area -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: TOP APP BAR ==================== -->
        <Grid Grid.Row="0"
              Height="54"
              Background="{ThemeResource AppTopBarBackgroundBrush}"
              BorderBrush="{ThemeResource AppDividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Back Button + Provider Icon + Title & Model Selector -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Back Button -->
                <Button Width="36"
                        Height="36"
                        Background="Transparent"
                        Click="HeaderBackButton_Click"
                        Margin="0,0,6,0"
                        ToolTipService.ToolTip="Back">
                    <TextBlock Text="&#xE72B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                </Button>

                <!-- Interactive Model Selector Button -->
                <Button x:Name="ModelSelectorButton"
                        Background="Transparent"
                        Padding="4,2,8,2"
                        Margin="0"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Switch AI">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Reusable Provider Brand Icon -->
                        <controls:WinAIProviderIcon x:Name="HeaderProviderIcon"
                                               ProviderId="openai"
                                               IconSize="32"
                                               BadgeCornerRadius="7"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>

                        <!-- Model Name on top + Provider Subtitle with chevron on bottom -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedModelHeaderText"
                                       Text="GPT-4o"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock x:Name="SelectedProviderHeaderText"
                                           Text="OpenAI"
                                           FontSize="11.5"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                                <TextBlock x:Name="KeyRequiredHeaderWarning"
                                           Text=" • Key required"
                                           FontSize="11"
                                           Foreground="{ThemeResource AppAccentBrush}"
                                           Visibility="Collapsed"/>
                                <TextBlock x:Name="ModelUnavailableHeaderWarning"
                                           Text=" • Unavailable"
                                           FontSize="11"
                                           Foreground="{ThemeResource WinAIErrorBrush}"
                                           Visibility="Collapsed"/>
                                <TextBlock Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="8"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           Margin="4,2,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Button.Flyout>
                        <Flyout x:Name="SwitchAiFlyout" Placement="Bottom" Opening="SwitchAiFlyout_Opening"
                                FlyoutPresenterStyle="{StaticResource ModernFlyoutPresenterStyle}">
                            <Grid Width="280">
                                <Grid.RowDefinitions>
                                    <!-- Header -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Separator -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- List -->
                                    <RowDefinition Height="*"/>
                                    <!-- Footer -->
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header: "Switch AI" -->
                                <Grid Grid.Row="0" Padding="16,12,16,10">
                                    <TextBlock Text="Switch AI"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                                </Grid>

                                <!-- Subtle Separator -->
                                <Border Grid.Row="1" Height="1" Background="{ThemeResource AppDividerBrush}"/>

                                <!-- Scrollable Model List -->
                                <ScrollViewer Grid.Row="2" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="SwitchAiModelList" Padding="0,4"/>
                                </ScrollViewer>

                                <!-- Footer: Key Vault & Settings -->
                                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource AppDividerBrush}">
                                    <Button x:Name="ManageKeysFlyoutButton"
                                            Background="Transparent"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="14,10"
                                            Click="ManageKeysFlyoutButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8D7;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource AppAccentBrush}"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Key Vault &amp; API Keys"
                                                       FontSize="12.5"
                                                       Foreground="{ThemeResource AppAccentBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!-- Right: Three-dot Overflow Menu -->
            <Button Grid.Column="1"
                    Width="38"
                    Height="38"
                    Background="Transparent"
                    ToolTipService.ToolTip="More Options">
                <TextBlock Text="&#xE712;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                <Button.Flyout>
                    <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource ModernMenuFlyoutStyle}">
                        <MenuFlyoutItem Text="New Chat" Click="NewChat_Click" />
                        <MenuFlyoutItem Text="Clear Chat" Click="ClearChat_Click" />
                        <MenuFlyoutItem Text="Copy Conversation" Click="CopyConversation_Click" />
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Settings &amp; Keys" Click="OpenSettings_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- ==================== ROW 1: CHAT FEED AREA ==================== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- Centered "Today" Date Separator -->
                <RowDefinition Height="Auto"/>
                <!-- Messages ListView -->
                <RowDefinition Height="*"/>
                <!-- Progress Ring / Typing indicator bubble -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Date Separator: ─── Today ─── -->
            <StackPanel Grid.Row="0">
                <Grid Margin="16,12,16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" Background="{ThemeResource AppDividerBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="Today" FontSize="11.5" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Height="1" Background="{ThemeResource AppDividerBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>

                <!-- Incremental Conversation Loading Banner / Button -->
                <Border x:Name="LoadEarlierMessagesBanner"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Margin="16,4,16,4"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Button x:Name="LoadEarlierMessagesButton"
                            Background="Transparent"
                            Padding="14,5"
                            Click="LoadEarlierMessagesButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressRing x:Name="LoadingEarlierRing"
                                          IsActive="False"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,8,0"
                                          Foreground="{ThemeResource AppAccentBrush}"
                                          Visibility="Collapsed"/>
                            <TextBlock Text="&#xE74B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{ThemeResource AppAccentBrush}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="LoadEarlierMessagesText"
                                       Text="Load earlier messages"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppAccentBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Selected Model Unavailable Alert Banner (Requirement 10) -->
                <Border x:Name="ChatModelUnavailableBanner"
                        Visibility="Collapsed"
                        Background="{ThemeResource WinAIErrorBrush}"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="16,4,16,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="White"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ChatModelUnavailableText"
                                   Text="Your selected model is unavailable. Tap header to choose another model."
                                   FontSize="12"
                                   FontFamily="Segoe UI"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ListView for Messages -->
            <ListView x:Name="ChatListView"
                      Grid.Row="1"
                      ItemsSource="{x:Bind Messages}"
                      ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                      SelectionMode="None"
                      Padding="12,4,12,4">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,2,0,2"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Transient Model Switch Toast (Temporary Notification Pill) -->
            <Border x:Name="ModelSwitchToast"
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12,5"
                    Visibility="Collapsed"
                    Canvas.ZIndex="100">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:WinAIProviderIcon x:Name="SwitchToastIcon"
                                           ProviderId="openai"
                                           IconSize="16"
                                           BadgeCornerRadius="4"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                    <TextBlock x:Name="SwitchToastText"
                               Text="Switched to Gemini"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Typing / Progress Indicator Bubble -->
            <Border x:Name="TypingIndicatorBubble"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource AppAiBubbleBrush}"
                    BorderBrush="{ThemeResource AppAiBubbleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,8"
                    Margin="14,0,48,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressRing x:Name="TypingProgressRing"
                                  IsActive="False"
                                  Width="16"
                                  Height="16"
                                  Foreground="{ThemeResource AppAccentBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"/>
                    <TextBlock x:Name="TypingIndicatorText"
                               Text="AI is thinking..."
                               FontSize="12"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== ROW 2: MESSAGE COMPOSER ==================== -->
        <Grid Grid.Row="2"
              Background="{ThemeResource AppPageBackgroundBrush}"
              Padding="12,6,12,8">
            <Grid.RowDefinitions>
                <!-- Attachment preview -->
                <RowDefinition Height="Auto"/>
                <!-- Voice Banner -->
                <RowDefinition Height="Auto"/>
                <!-- Input row -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Attachment Preview Bar -->
            <Border x:Name="AttachmentPreviewBar"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,6"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="AttachmentThumbnailImage"
                           Grid.Column="0"
                           Width="40"
                           Height="40"
                           Stretch="UniformToFill"
                           Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AttachmentFileNameText"
                                   Text="Image Attached"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Ready for Vision Analysis"
                                   FontSize="10.5"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Width="30"
                            Height="30"
                            Background="Transparent"
                            Click="RemoveAttachment_Click">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Voice Status / Error Banner -->
            <Border x:Name="VoiceStatusBanner"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{ThemeResource WinAIErrorBrush}"
                    CornerRadius="6"
                    Padding="10,6"
                    Margin="0,0,0,6"
                    Tapped="VoiceStatusBanner_Tapped">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="VoiceStatusBannerIcon" Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VoiceStatusBannerText" Text="Microphone permission is required." FontSize="12" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="WrapWholeWords"/>
                </StackPanel>
            </Border>

            <!-- Modern Translucent Chat Composer Bar matching Screenshot 2 & 3 -->
            <Border Grid.Row="2"
                    Background="{ThemeResource AppTranslucentBarBrush}"
                    BorderBrush="{ThemeResource AppTranslucentBarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    MinHeight="46"
                    Padding="6,2,6,2"
                    Margin="0,2,0,4">
                <Grid>
                    <!-- State 1: Normal Text Input Bar (Screenshot 2) -->
                    <Grid x:Name="NormalInputGrid" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: + Attachment Button -->
                        <Button x:Name="AttachButton"
                                Grid.Column="0"
                                Style="{StaticResource WinAIIconButtonStyle}"
                                Width="38"
                                Height="38"
                                VerticalAlignment="Bottom"
                                Click="AttachButton_Click"
                                ToolTipService.ToolTip="Add attachment">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <!-- Center: Multiline Input Box (Transparent, grows upward like Unison) -->
                        <TextBox x:Name="InputTextBox"
                                 Grid.Column="1"
                                 Style="{StaticResource WinAITransparentTextBoxStyle}"
                                 PlaceholderText="Type a message"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="38"
                                 MaxHeight="120"
                                 InputScope="Chat"
                                 VerticalAlignment="Bottom"
                                 VerticalContentAlignment="Center"
                                 Margin="4,0,4,0"
                                 Padding="6,8,6,6"
                                 TextChanged="InputTextBox_TextChanged"
                                 KeyDown="InputTextBox_KeyDown" />

                        <!-- Right 1: Voice Microphone Button -->
                        <Button x:Name="VoiceRecordButton"
                                Grid.Column="2"
                                Style="{StaticResource WinAIIconButtonStyle}"
                                Width="38"
                                Height="38"
                                VerticalAlignment="Bottom"
                                Click="VoiceRecordButton_Click"
                                ToolTipService.ToolTip="Voice message">
                            <TextBlock Text="&#xE720;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       Foreground="{ThemeResource AppAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <!-- Right 2: Send Button (No grey rectangle in any state) -->
                        <Button x:Name="SendButton"
                                Grid.Column="3"
                                Style="{StaticResource WinAIIconButtonStyle}"
                                Width="38"
                                Height="38"
                                VerticalAlignment="Bottom"
                                Click="SendButton_Click"
                                ToolTipService.ToolTip="Send message">
                            <TextBlock Text="&#xE724;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{ThemeResource AppAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- State 2: Active Voice Recording Bar (Native Windows Phone Listening UI) -->
                    <Grid x:Name="VoiceRecordingGrid" Visibility="Collapsed" MinHeight="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Animated Microphone Indicator -->
                        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="6,0,8,0" Width="28" Height="28">
                            <Ellipse x:Name="VoicePulseDot"
                                     Width="28" Height="28"
                                     Fill="{ThemeResource AppVoiceRecordActiveBrush}"
                                     Opacity="0.25"/>
                            <TextBlock x:Name="VoiceMicIcon"
                                       Text="&#xE720;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{ThemeResource AppVoiceRecordActiveBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Column 1: Status & Live Transcription -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,2,6,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top line: Status, Timer, and subtle waveform bars -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="VoiceRecordingStatusText"
                                           Text="Listening..."
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppVoiceRecordActiveBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="VoiceRecordingTimerText"
                                           Text="0:00"
                                           FontSize="13"
                                           FontFamily="Segoe UI"
                                           FontWeight="Normal"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>

                                <!-- Subtle Native Windows Phone Audio Waveform Indicator -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle x:Name="VoiceWave1" Width="2.5" Height="8" RadiusX="1" RadiusY="1" Fill="{ThemeResource AppVoiceRecordActiveBrush}" Opacity="0.7" Margin="0,0,2,0"/>
                                    <Rectangle x:Name="VoiceWave2" Width="2.5" Height="14" RadiusX="1" RadiusY="1" Fill="{ThemeResource AppVoiceRecordActiveBrush}" Opacity="0.9" Margin="0,0,2,0"/>
                                    <Rectangle x:Name="VoiceWave3" Width="2.5" Height="10" RadiusX="1" RadiusY="1" Fill="{ThemeResource AppVoiceRecordActiveBrush}" Opacity="0.75" Margin="0,0,2,0"/>
                                    <Rectangle x:Name="VoiceWave4" Width="2.5" Height="6" RadiusX="1" RadiusY="1" Fill="{ThemeResource AppVoiceRecordActiveBrush}" Opacity="0.6"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Bottom line: Live interim transcribed text (hypothesis) -->
                            <TextBlock x:Name="VoiceHypothesisText"
                                       Grid.Row="1"
                                       Text="Speak now..."
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       Margin="0,2,0,0"/>
                        </Grid>

                        <!-- Column 2: Cancel Recording Button -->
                        <Button x:Name="CancelVoiceRecordingButton"
                                Grid.Column="2"
                                Style="{StaticResource WinAIIconButtonStyle}"
                                Width="38"
                                Height="38"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                Click="CancelVoiceRecordingButton_Click"
                                ToolTipService.ToolTip="Cancel">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <!-- Column 3: Done Recording Button (Checkmark - puts text into composer without auto-sending) -->
                        <Button x:Name="DoneVoiceRecordingButton"
                                Grid.Column="3"
                                Style="{StaticResource WinAIIconButtonStyle}"
                                Width="38"
                                Height="38"
                                VerticalAlignment="Center"
                                Click="DoneVoiceRecordingButton_Click"
                                ToolTipService.ToolTip="Done (insert text)">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{ThemeResource AppAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== FULL-SIZE IMAGE VIEWER LIGHTBOX ==================== -->
        <Grid x:Name="LightboxOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Canvas.ZIndex="2000"
              Visibility="Collapsed"
              Background="#EE000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Action Header -->
            <Border Grid.Row="0"
                    Padding="16,14,16,10"
                    Background="#55000000">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Close Button -->
                    <Button Grid.Column="0"
                            Width="38"
                            Height="38"
                            Background="Transparent"
                            Padding="0"
                            Click="CloseLightbox_Click">
                        <TextBlock Text="&#xE106;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="White"/>
                    </Button>

                    <!-- Title & Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                        <TextBlock x:Name="LightboxTitleText"
                                   Text="Image Preview"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="LightboxSubtitleText"
                                   Text="Full Resolution"
                                   FontSize="11"
                                   Foreground="#AAA"/>
                    </StackPanel>

                    <!-- Save to Pictures -->
                    <Button Grid.Column="2"
                            Width="38"
                            Height="38"
                            Background="Transparent"
                            Padding="0"
                            Click="SaveLightboxImage_Click"
                            ToolTipService.ToolTip="Save to Pictures">
                        <TextBlock Text="&#xE74E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="White"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Zoomable Image Viewport Container -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="LightboxScrollViewer"
                              ZoomMode="Enabled"
                              MinZoomFactor="1.0"
                              MaxZoomFactor="4.0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              SizeChanged="LightboxScrollViewer_SizeChanged"
                              ViewChanged="LightboxScrollViewer_ViewChanged">
                    <Grid x:Name="LightboxImageContainer"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          DoubleTapped="LightboxImageContainer_DoubleTapped">
                        <ProgressRing x:Name="LightboxLoadingRing"
                                      IsActive="True"
                                      Width="45"
                                      Height="45"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        <Image x:Name="LightboxImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               ImageOpened="LightboxImage_ImageOpened"
                               ImageFailed="LightboxImage_ImageFailed"/>
                    </Grid>
                </ScrollViewer>

                <!-- Floating Zoom Toolbar -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,24"
                        CornerRadius="20"
                        Background="#D016181C"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Zoom Out -->
                        <Button Width="36" Height="36"
                                Background="Transparent"
                                Padding="0"
                                Click="ZoomOut_Click"
                                ToolTipService.ToolTip="Zoom Out">
                            <TextBlock Text="&#xE71F;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <!-- Zoom Level Percentage -->
                        <TextBlock x:Name="ZoomLevelText"
                                   Text="100%"
                                   Width="48"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <!-- Zoom In -->
                        <Button Width="36" Height="36"
                                Background="Transparent"
                                Padding="0"
                                Click="ZoomIn_Click"
                                ToolTipService.ToolTip="Zoom In">
                            <TextBlock Text="&#xE71E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <Border Width="1" Height="18" Background="#44FFFFFF" Margin="4,0,4,0"/>

                        <!-- Fit to Screen / Reset -->
                        <Button Width="36" Height="36"
                                Background="Transparent"
                                Padding="0"
                                Click="ZoomReset_Click"
                                ToolTipService.ToolTip="Fit to Screen">
                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
