<UserControl
    x:Class="WinAI.Controls.VaultProviderItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinAI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          PointerPressed="RootGrid_PointerPressed"
          PointerReleased="RootGrid_PointerReleased"
          PointerExited="RootGrid_PointerExited"
          PointerCanceled="RootGrid_PointerCanceled"
          PointerCaptureLost="RootGrid_PointerCaptureLost"
          Tapped="RootGrid_Tapped">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppItemPressedBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppItemPressedBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
        </Grid.RowDefinitions>

        <!-- Main Provider Row -->
        <Grid Grid.Row="0" Padding="18,12,18,12">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Provider Icon -->
                <ColumnDefinition Width="Auto" />
                <!-- Column 1: Provider Name, Masked Key & Status -->
                <ColumnDefinition Width="*" />
                <!-- Column 2: Overflow Three-Dot Menu (for configured) / Add Action -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Reusable Unified Brand Icon -->
            <controls:WinAIProviderIcon x:Name="BrandIcon"
                                        Grid.Column="0"
                                        IconSize="38"
                                        BadgeCornerRadius="8"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0" />

            <!-- Provider Name, Masked Key (••••••••••••••••) & Status -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                <TextBlock x:Name="ProviderNameText"
                           Text="Provider Name"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}" />

                <!-- Masked Key: Never plaintext -->
                <TextBlock x:Name="MaskedKeyText"
                           Text="••••••••••••••••"
                           FontSize="12"
                           FontFamily="Segoe UI"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                           Margin="0,2,0,2" />

                <!-- Status indicator: ● Configured / ○ Not configured -->
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <TextBlock x:Name="StatusDot"
                               Text="●"
                               FontSize="9"
                               Foreground="{ThemeResource WinAISuccessBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <TextBlock x:Name="StatusText"
                               Text="Configured"
                               FontSize="11.5"
                               Foreground="{ThemeResource WinAISuccessBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Actions Column -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <!-- Three-Dot Overflow Menu for Configured Provider Rows (Phase 3 Requirement 2) -->
                <Button x:Name="MoreButton"
                        Width="36"
                        Height="36"
                        Background="Transparent"
                        Padding="0"
                        Tapped="MoreButton_Tapped"
                        ToolTipService.ToolTip="Key options">
                    <TextBlock Text="&#xE712;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="ItemMenuFlyout"
                                    MenuFlyoutPresenterStyle="{StaticResource ModernMenuFlyoutStyle}">
                            <MenuFlyoutItem x:Name="CopyMenuItem"
                                            Text="Copy API Key"
                                            Click="MenuCopy_Click" />
                            <MenuFlyoutItem x:Name="RemoveMenuItem"
                                            Text="Remove API Key"
                                            Foreground="{ThemeResource WinAIErrorBrush}"
                                            Click="MenuRemove_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="CancelMenuItem"
                                            Text="Cancel"
                                            Click="MenuCancel_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Subtle Separator -->
        <Border Grid.Row="1"
                Background="{ThemeResource AppDividerBrush}"
                Margin="70,0,0,0" />
    </Grid>
</UserControl>
