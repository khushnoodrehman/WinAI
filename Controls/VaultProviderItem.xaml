<UserControl
    x:Class="WinAI.Controls.VaultProviderItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
        </Grid.RowDefinitions>

        <!-- Main Provider Row -->
        <Grid Grid.Row="0" Padding="18,12,18,12">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Provider Icon -->
                <ColumnDefinition Width="Auto" />
                <!-- Column 1: Provider Name & Status -->
                <ColumnDefinition Width="*" />
                <!-- Column 2: Masked Key, Eye Button, Overflow Menu -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Icon Box -->
            <Border Grid.Column="0"
                    x:Name="IconBorder"
                    Width="38"
                    Height="38"
                    CornerRadius="8"
                    VerticalAlignment="Center"
                    Margin="0,0,14,0">
                <ContentControl x:Name="IconContentPresenter"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />
            </Border>

            <!-- Provider Name & Connection Status -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                <TextBlock x:Name="ProviderNameText"
                           Text="Provider Name"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}" />

                <!-- Status indicator: ● Connected / ● Not configured -->
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock x:Name="StatusDot"
                               Text="●"
                               FontSize="9"
                               Foreground="#10A37F"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <TextBlock x:Name="StatusText"
                               Text="Connected"
                               FontSize="11.5"
                               Foreground="#10A37F"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Masked Key, Reveal Eye Button, and Three-Dot Menu -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <!-- Masked Key -->
                <TextBlock x:Name="MaskedKeyText"
                           Text="••••••••••••"
                           FontSize="12"
                           FontFamily="Segoe UI"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <!-- Eye / Reveal Button -->
                <Button x:Name="EyeButton"
                        Width="32"
                        Height="32"
                        Background="Transparent"
                        Padding="0"
                        Margin="0,0,4,0"
                        Click="EyeButton_Click"
                        ToolTipService.ToolTip="Reveal / Mask Key">
                    <TextBlock x:Name="EyeIcon"
                               Text="&#xE890;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                </Button>

                <!-- Three-Dot Overflow Menu -->
                <Button x:Name="MoreButton"
                        Width="32"
                        Height="32"
                        Background="Transparent"
                        Padding="0"
                        ToolTipService.ToolTip="More Options">
                    <TextBlock Text="&#xE712;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Edit Key" Click="MenuEdit_Click" />
                            <MenuFlyoutItem Text="Test Connection" Click="MenuTest_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="DeleteMenuItem"
                                            Text="Delete Key"
                                            Foreground="#E04040"
                                            Click="MenuDelete_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Subtle Separator -->
        <Border Grid.Row="1"
                Background="{ThemeResource AppDividerBrush}"
                Margin="70,0,0,0" />
    </Grid>
</UserControl>
